# chezmoi:modify-template
{{- /* Docs: https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-config-dir-reference
       Host model/UI choices survive apply; mise owns updates. askUser lets autopilot pause on
       unclear requirements; connectors, remoteExport, remoteSessions, and storeTokenPlaintext stay
       off for session/credential isolation; worktreeBaseRef pins clean worktrees to HEAD. */ -}}
{{- $defaults := fromJson `
{
  "banner": "never",
  "contextTier": "long_context",
  "effortLevel": "high",
  "keepAlive": "busy",
  "model": "auto"
}
` -}}
{{- $managedConfig := fromJson `
{
  "askUser": true,
  "autoUpdate": false,
  "connectors": false,
  "continueOnAutoMode": true,
  "defaultMode": "autopilot",
  "defaultPermissionMode": "allow-all",
  "editorMode": "vim",
  "includeCoAuthoredBy": false,
  "notifications": true,
  "remoteExport": false,
  "remoteSessions": false,
  "respectGitignore": false,
  "storeTokenPlaintext": false,
  "theme": "default",
  "worktreeBaseRef": "head"
}
` -}}
{{- includeTemplate "config-merge.tmpl" (dict "stdin" .chezmoi.stdin "defaults" $defaults "managed" $managedConfig "format" "jsonc") -}}
