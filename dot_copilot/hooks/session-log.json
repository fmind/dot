{
  "version": 1,
  "hooks": {
    "agentStop": [
      {
        "type": "command",
        "bash": "dot agent hook notify copilot stop",
        "timeoutSec": 30
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "dot agent hook copilot-session-end",
        "timeoutSec": 10
      }
    ]
  }
}
