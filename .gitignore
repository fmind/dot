# Docs: https://git-scm.com/docs/gitignore

# Local agent state; shared skills remain versioned.
.agents/prompts/
.agents/tmp/
.antigravitycli/
.claude/*
!.claude/skills
.codex/
.gemini/
.grok/

# Python environments, caches, and generated distributions at any depth.
*.py[co]
.cache/
.coverage*
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ty_cache/
.venv/
__pycache__/
build/
dist/
htmlcov/

# Only the managed launcher belongs in this generated bin directory.
dot_local/bin/*
!dot_local/bin/symlink_dot.tmpl

# Optional workstation locks stay local; shared dependency graphs are versioned.
dot_config/mise/mise.local.lock
dot_config/mise/locks/mise.local/

# Machine-specific CLI configuration stays local.
dot_config/dot.yaml
dot_config/dot.*.yaml

# Machine-specific Git configuration stays local.
dot_config/git/config.local
dot_config/git/config.*
