# chezmoi:modify-template
{{- /* Docs: https://antigravity.google/docs/remote-control/
       Remote Control reads protobuf JSON, not the CLI settings schema; the daemon reads it
       only at start. autoContinueOnMaxGeneratorInvocations is undocumented (verified in
       agy 1.5.5–1.5.14): it skips the "continue?" prompt after the step budget. */ -}}
{{- $managed := fromJson `
{
  "userSettings": {
    "autoContinueOnMaxGeneratorInvocations": "AUTO_CONTINUE_ON_MAX_GENERATOR_INVOCATIONS_ENABLED",
    "autoExecutionPolicy": "CASCADE_COMMANDS_AUTO_EXECUTION_EAGER",
    "artifactReviewMode": "ARTIFACT_REVIEW_MODE_TURBO",
    "permissionPreset": "AGENT_PERMISSION_PRESET_TURBO",
    "allowAgentAccessNonWorkspaceFiles": true,
    "nonWorkspaceFileAccessPolicy": "AGENT_SETTING_POLICY_ALLOW",
    "enableNotificationsForSpecialEvents": true
  }
}
` -}}
{{- $current := dict -}}
{{- if ne (trim .chezmoi.stdin) "" }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- if not (kindIs "map" $current) }}{{ fail "existing configuration must be an object" }}{{ end -}}
{{- $userSettings := dict -}}
{{- if and (hasKey $current "userSettings") (ne (get $current "userSettings") nil) }}{{ $userSettings = get $current "userSettings" }}{{ end -}}
{{- if not (kindIs "map" $userSettings) }}{{ fail "userSettings must be an object" }}{{ end -}}
{{- $grantsMap := dict -}}
{{- if and (hasKey $userSettings "globalPermissionGrants") (ne (get $userSettings "globalPermissionGrants") nil) }}{{ $grantsMap = get $userSettings "globalPermissionGrants" }}{{ end -}}
{{- if not (kindIs "map" $grantsMap) }}{{ fail "globalPermissionGrants must be an object" }}{{ end -}}
{{- $allow := list -}}
{{- if and (hasKey $grantsMap "allow") (ne (get $grantsMap "allow") nil) }}{{ $allow = get $grantsMap "allow" }}{{ end -}}
{{- if not (kindIs "slice" $allow) }}{{ fail "globalPermissionGrants.allow must be an array" }}{{ end -}}
{{- $deny := list -}}
{{- if and (hasKey $grantsMap "deny") (ne (get $grantsMap "deny") nil) }}{{ $deny = get $grantsMap "deny" }}{{ end -}}
{{- if not (kindIs "slice" $deny) }}{{ fail "globalPermissionGrants.deny must be an array" }}{{ end -}}
{{- /* Full autonomy for remote sessions (developer, 2026-10-01): wildcard grants for every action
       (https://antigravity.google/docs/permissions) paired with managed credential-store read_file denies
       (`read_file(<dir>)` matches contained files recursively) without replacing host-owned allow/ask/deny lists. */ -}}
{{- $grants := list "read_file(*)" "write_file(*)" "command(*)" "read_url(*)" "execute_url(*)" "mcp(*)" -}}
{{- $managedDeny := fromJson (includeTemplate "agy-secret-denies.tmpl" .) -}}
{{- $_ := set (get $managed "userSettings") "globalPermissionGrants" (dict "allow" (concat $allow $grants | uniq) "deny" (concat $deny $managedDeny | uniq)) -}}
{{- includeTemplate "config-merge.tmpl" (dict "stdin" .chezmoi.stdin "managed" $managed) -}}
