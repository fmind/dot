#!/bin/sh
# Enable the hourly `fkf update` job after its definition changes; it collects only the bases
# that ~/.config/fkf/config.yaml trusts with `collect: true`.
{{- if eq .chezmoi.os "linux" }}
# fkf-update.timer: {{ include "dot_config/systemd/user/fkf-update.timer" | sha256sum }}
# fkf-update.service: {{ include "dot_config/systemd/user/fkf-update.service" | sha256sum }}
set -eu
command -v systemctl >/dev/null 2>&1 || exit 0
# Skip hosts without a running user manager; a degraded manager still runs timers.
state=$(systemctl --user is-system-running 2>/dev/null || true)
case "${state}" in running | degraded) ;; *) exit 0 ;; esac
systemctl --user daemon-reload
systemctl --user enable --now fkf-update.timer >/dev/null
{{- else if eq .chezmoi.os "darwin" }}
# dev.fmind.fkf-update.plist: {{ include "Library/LaunchAgents/dev.fmind.fkf-update.plist.tmpl" | sha256sum }}
set -eu
agent="{{ .chezmoi.homeDir }}/Library/LaunchAgents/dev.fmind.fkf-update.plist"
domain="gui/$(id -u)"
launchctl bootout "${domain}/dev.fmind.fkf-update" >/dev/null 2>&1 || true
launchctl bootstrap "${domain}" "${agent}"
{{- end }}
