# chezmoi:modify-template
{{- /* Docs: https://code.claude.com/docs/en/settings
       Seed model, effort, and remoteControlAtStartup via `defaults` (preserving `/model`, `/effort`, and host overrides;
       Opus 5.5 needs per-model effortLevel); `dot trust` owns folder trust and `permissions.additionalDirectories`.
       Suppress updates, telemetry, claude.ai connectors/plugins/skills, and git/gh/gcloud prompts; force session
       persistence under CLAUDE_CODE_CHILD_SESSION; use `light-ansi` for Ghostty's palette. */ -}}
{{- $defaults := dict "model" "fable" "modelSettings" (dict "claude-fable-5-1" (dict "effortLevel" "high") "claude-fable-5-2" (dict "effortLevel" "high") "claude-opus-5-5" (dict "effortLevel" "high")) "remoteControlAtStartup" true -}}
{{- $managedConfig := fromJson `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoContinueAtUsageLimit": true,
  "autoInstallIdeExtension": false,
  "disableClaudeAiConnectors": true,
  "disableDeepLinkRegistration": "disable",
  "editorMode": "vim",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1",
    "CLOUDSDK_CORE_DISABLE_PROMPTS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_UPDATES": "1",
    "GH_PROMPT_DISABLED": "1",
    "GIT_TERMINAL_PROMPT": "0"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "fastModePerSessionOptIn": true,
  "feedbackSurveyRate": 0,
  "inputNeededNotifEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "respectGitignore": false,
  "skillListingBudgetFraction": 0.02,
  "skipDangerousModePermissionPrompt": true,
  "spinnerTipsEnabled": false,
  "syncClaudeAiPlugins": false,
  "syncClaudeAiSkills": false,
  "theme": "light-ansi",
  "tui": "fullscreen",
  "workflowSizeGuideline": "large",
  "worktree": {
    "baseRef": "head"
  }
}
` -}}
{{- /* Preserve host-owned hook events (such as SessionStart) while retiring managed Notification entries,
       and union managed workstation credential-store Read denies into permissions.deny (enforced across
       Read/Grep/Glob even under bypassPermissions, since Claude subagent disallowedTools strips bare Read
       when parameterized Read(...) rules are placed there). */ -}}
{{- $current := dict -}}
{{- if ne (trim .chezmoi.stdin) "" }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- if not (kindIs "map" $current) }}{{ fail "existing configuration must be an object" }}{{ end -}}
{{- $currentHooks := get $current "hooks" | default dict -}}
{{- if not (kindIs "map" $currentHooks) }}{{ fail "hooks must be an object" }}{{ end -}}
{{- $preservedHooks := dict -}}
{{- range $event, $entries := $currentHooks -}}
{{-   if ne $event "Notification" }}{{ $_ := set $preservedHooks $event $entries }}{{ end -}}
{{- end -}}
{{- if gt (len $preservedHooks) 0 }}{{ $_ := set $managedConfig "hooks" $preservedHooks }}{{ end -}}
{{- $currentPerms := get $current "permissions" | default dict -}}
{{- if not (kindIs "map" $currentPerms) }}{{ fail "permissions must be an object" }}{{ end -}}
{{- $currentDeny := get $currentPerms "deny" | default list -}}
{{- if not (kindIs "slice" $currentDeny) }}{{ fail "permissions.deny must be a list" }}{{ end -}}
{{- $secretPaths := get (fromJson (includeTemplate "secret-deny-paths.tmpl" .)) "paths" -}}
{{- $managedDeny := list -}}
{{- range $entry := $secretPaths -}}
{{-   if $entry.dir -}}
{{-     $managedDeny = append $managedDeny (printf "Read(~/%s/**)" $entry.path) -}}
{{-   else -}}
{{-     $managedDeny = append $managedDeny (printf "Read(~/%s)" $entry.path) -}}
{{-   end -}}
{{- end -}}
{{- $mergedDeny := concat $currentDeny $managedDeny | uniq -}}
{{- $_ := set (get $managedConfig "permissions") "deny" $mergedDeny -}}
{{- includeTemplate "config-merge.tmpl" (dict "stdin" .chezmoi.stdin "defaults" $defaults "managed" $managedConfig "replace" (list "hooks")) -}}
