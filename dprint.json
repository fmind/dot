{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "excludes": [
    "**/*-lock.json",
    "dot_config/mise/locks/**",
    "**/modify_*.json",
    "**/modify_*.toml",
    "dot_claude/agents/**",
    "dot_codex/agents/**",
    "dot_copilot/agents/**",
    "dot_gemini/private_config/agents/**",
    "dot_grok/agents/**",
    "dot_config/opencode/agents/**"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0"
  ]
}
