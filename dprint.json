{
  "$schema": "https://dprint.dev/schemas/v0.json",
  // Docs: https://dprint.dev/config/
  "lineWidth": 120,
  "excludes": [
    "**/*-lock.json",
    "dot_config/mise/locks/**",
    "dot_config/private_opencode/agents/**",
    "private_dot_claude/agents/**",
    "private_dot_copilot/agents/**",
    "private_dot_gemini/private_config/agents/**",
    "**/modify_*.json",
    "**/modify_*.toml"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/toml@0.10.0"
  ]
}
