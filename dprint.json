{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "excludes": [
    "**/*-lock.json",
    "**/.cache",
    "**/.git",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.ty_cache",
    "**/.venv",
    "**/__pycache__",
    "**/build",
    "**/dist",
    "**/htmlcov",
    "**/modify_*.json",
    "**/modify_*.yaml",
    "**/modify_private_config.toml",
    "**/node_modules",
    "**/references/**"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.23.0",
    "npm:@dprint/markdown@0.23.3",
    "npm:@dprint/toml@0.8.0"
  ]
}
