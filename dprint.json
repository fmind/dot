{
  "$schema": "https://dprint.dev/schemas/v0.json",
  // Docs: https://dprint.dev/config/
  "lineWidth": 120,
  "excludes": [
    "**/*-lock.json",
    "dot_config/mise/locks/**",
    "**/modify_*.json",
    "**/modify_*.toml"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.2",
    "npm:@dprint/toml@0.9.0"
  ]
}
