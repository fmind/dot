{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "excludes": [
    "**/*-lock.json",
    "dot_config/mise/locks/**",
    "**/modify_*.json",
    "**/modify_*.toml",
    "dot_claude/exact_agents/**",
    "dot_codex/exact_agents/**",
    "dot_copilot/exact_agents/**",
    "dot_gemini/private_config/exact_agents/**",
    "dot_grok/exact_agents/**",
    "dot_config/opencode/exact_agents/**"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.26.0",
    "npm:@dprint/toml@0.9.0"
  ]
}
