{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "excludes": [
    "**/*-lock.json",
    "dot_config/mise/locks/**",
    "**/.cache",
    "**/.git",
    "**/.mypy_cache",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.ty_cache",
    "**/.venv",
    "**/__pycache__",
    "**/build",
    "**/dist",
    "**/htmlcov",
    "**/modify_*.json",
    "**/modify_*.toml",
    "**/modify_*.yaml",
    "**/node_modules"
  ],
  "markdown": {
    "textWrap": "never"
  },
  "plugins": [
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/json@0.24.0",
    "npm:@dprint/markdown@0.24.0",
    "npm:@dprint/toml@0.8.0"
  ]
}
