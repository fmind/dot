{{- /* Seed absent preferences, preserve host state, then enforce managed policy. */ -}}
{{- $current := dict -}}
{{- if ne (trim .stdin) "" }}{{ $current = mustFromJson .stdin }}{{ end -}}
{{- if not (kindIs "map" $current) }}{{ fail "existing JSON configuration must be an object" }}{{ end -}}
{{- $defaults := get . "defaults" | default dict -}}
{{- $desired := mergeOverwrite (deepCopy $defaults) (deepCopy $current) .managed -}}
{{- if and (ne (trim .stdin) "") (deepEqual $current $desired) -}}
{{ .stdin -}}
{{- else -}}
{{ $desired | toPrettyJson }}
{{- end -}}
