{{- /*
  Rewrite a `# chezmoi: NAME` .. `# chezmoi: end NAME` block in place when both markers exist,
  leave a begin-only legacy block untouched, or insert at `position` (top|bottom).
  Params: stdin, name, body, position.
*/ -}}
{{- $begin := printf "# chezmoi: %s" .name -}}
{{- $end := printf "# chezmoi: end %s" .name -}}
{{- $block := printf "%s\n%s\n%s" $begin .body $end -}}
{{- $span := printf "(?ms)^%s\\n.*?^%s$" (regexQuoteMeta $begin) (regexQuoteMeta $end) -}}
{{- $open := printf "(?m)^%s$" (regexQuoteMeta $begin) -}}
{{- $text := .stdin -}}
{{- if regexMatch $span $text -}}
{{-   $text = regexReplaceAllLiteral $span $text $block -}}
{{- else if regexMatch $open $text -}}
{{- else if eq (trim $text) "" -}}
{{-   $text = print $block "\n" -}}
{{- else if eq .position "top" -}}
{{-   $text = print $block "\n\n" $text -}}
{{- else -}}
{{-   $text = print $text "\n" $block "\n" -}}
{{- end -}}
{{- $text -}}
