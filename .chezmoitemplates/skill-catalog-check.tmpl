{{- /* Reserve only this checkout's skill names; --force must not replace another owner's package. */ -}}
{{- $source := joinPath .chezmoi.sourceDir "skills" -}}
{{- $catalog := joinPath .chezmoi.destDir ".agents/skills" -}}
{{- $catalogInfo := lstat $catalog -}}
{{- if and $catalogInfo (or (eq $catalogInfo.type "symlink") (not $catalogInfo.isDir)) -}}
  {{- fail "global skills catalog must be a real directory; resolve its owner before applying" -}}
{{- end -}}
{{- /* Reject glob characters in the checkout path; the glob below would match other directories. */ -}}
{{- $directory := joinPath .chezmoi.sourceDir "dot_agents/skills" -}}
{{- if regexMatch "[\\[\\]*?{}\\\\]" $directory }}{{ fail "chezmoi source path contains glob characters; move the checkout before applying" }}{{ end -}}
{{- $names := list -}}
{{- $links := list -}}
{{- range glob (printf "%s/symlink_*.tmpl" $directory) -}}
{{- $name := base . | trimPrefix "symlink_" | trimSuffix ".tmpl" -}}
{{- $target := joinPath $catalog $name -}}
{{- $info := lstat $target -}}
{{- if $info -}}
  {{- if ne $info.type "symlink" -}}
    {{- fail (printf "skill %s already exists; relocate the conflicting package before applying" $name) -}}
  {{- end -}}
  {{- $names = append $names $name -}}
  {{- $links = append $links $target -}}
{{- end -}}
{{- end -}}
{{- /* One readlink for every link: a process per skill added about 90 ms to every chezmoi command. */ -}}
{{- if $links -}}
{{- $targets := outputList "readlink" $links | trimSuffix "\n" | splitList "\n" -}}
{{- range $index, $name := $names -}}
  {{- if ne (index $targets $index) (joinPath $source $name) -}}
    {{- fail (printf "skill %s belongs to another source; resolve the name collision before applying" $name) -}}
  {{- end -}}
{{- end -}}
{{- end -}}
{{- /* Host links replace their target under --force; refuse to discard an existing host skill directory. */ -}}
{{- range $link := list ".claude/skills" ".gemini/config/skills" ".grok/skills" -}}
{{- $linkInfo := lstat (joinPath $.chezmoi.destDir $link) -}}
{{- if and $linkInfo (ne $linkInfo.type "symlink") -}}
  {{- fail (printf "~/%s already exists; move its skills into ~/.agents/skills before applying" $link) -}}
{{- end -}}
{{- end -}}
