{{- /* Reserve only this checkout's skill names; --force must not replace another owner's package. */ -}}
{{- $source := joinPath .chezmoi.sourceDir "skills" -}}
{{- $catalog := joinPath .chezmoi.destDir ".agents/skills" -}}
{{- $catalogInfo := lstat $catalog -}}
{{- $legacy := false -}}
{{- if $catalogInfo -}}
  {{- if eq $catalogInfo.type "symlink" -}}
    {{- if ne (output "readlink" $catalog | trim) $source -}}
      {{- fail "global skills directory links elsewhere; migrate it to a real directory before applying" -}}
    {{- end -}}
    {{- range glob (joinPath $source "*") -}}
      {{- if eq (lstat .).type "symlink" -}}
        {{- fail "legacy catalog contains separately installed links; move them outside this checkout before applying" -}}
      {{- end -}}
    {{- end -}}
    {{- $legacy = true -}}
  {{- else if not $catalogInfo.isDir -}}
    {{- fail "global skills catalog must be a directory" -}}
  {{- end -}}
{{- end -}}
{{- if not $legacy -}}
{{- range glob (joinPath .chezmoi.sourceDir "dot_agents/skills/symlink_*.tmpl") -}}
{{- $name := base . | trimPrefix "symlink_" | trimSuffix ".tmpl" -}}
{{- $target := joinPath $catalog $name -}}
{{- $expected := joinPath $source $name -}}
{{- $info := lstat $target -}}
{{- if $info -}}
  {{- if ne $info.type "symlink" -}}
    {{- fail (printf "skill %s already exists; relocate the conflicting package before applying" $name) -}}
  {{- end -}}
  {{- if ne (output "readlink" $target | trim) $expected -}}
    {{- fail (printf "skill %s belongs to another source; resolve the name collision before applying" $name) -}}
  {{- end -}}
{{- end -}}
{{- end -}}
{{- end -}}
