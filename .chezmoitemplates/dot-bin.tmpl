{{- /* Absolute dot path for harness hook commands. A harness started without ~/.local/bin on
       PATH cannot resolve dot, or resolves Graphviz's /usr/bin/dot instead, and notifications
       fail silently. Hosts run the command through a shell, so the path must need no quoting. */ -}}
{{- $dot := joinPath .chezmoi.homeDir ".local/bin/dot" -}}
{{- if not (regexMatch "^[A-Za-z0-9_@%+=:,./-]+$" $dot) }}{{ fail "home directory is not shell-safe for hook commands" }}{{ end -}}
{{- $dot -}}
