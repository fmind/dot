{{- /* Antigravity read_file() matches exact paths and recursive directories (resolving symlinks),
       NOT wildcard filename globs (glob patterns are silent no-ops in agy 1.5.16).
       Relative filenames match workspace-root paths only; cloud metadata hosts deny SSRF. */ -}}
{{- $paths := list
  ".ssh"
  ".gnupg"
  ".aws"
  ".config/gcloud"
  ".kube"
  ".netrc"
  ".pgpass"
  ".git-credentials"
  ".npmrc"
  ".pypirc"
  ".docker/config.json"
  ".terraform.d/credentials.tfrc.json"
  ".claude/.credentials.json"
  ".claude/projects"
  ".copilot/config.json"
  ".copilot/mcp-config.json"
  ".gemini/antigravity-cli/antigravity-oauth-token"
  ".gemini/config/mcp_config.json"
  ".pi/agent/auth.json"
  ".pi/agent/models.json"
  ".pi/agent/mcp.json"
  ".pi/agent/sessions"
  ".config/dot/secrets"
  ".config/dot.yaml"
  ".config/git/config.local"
  ".config/chezmoi/key.txt"
  ".config/chezmoi/chezmoi.toml"
  ".config/chezmoi/chezmoistate.boltdb"
  ".config/bf"
  ".config/gws"
  ".config/gh/hosts.yml"
  ".config/pup"
  ".config/atuin"
  ".local/share/atuin"
  ".local/share/fish/fish_history"
  ".bash_history"
  ".zsh_history"
  ".local/share/keyrings"
  ".config/opencode"
  ".local/share/opencode"
  ".cache/huggingface/token"
  ".cache/huggingface/stored_tokens"
  ".kaggle"
  ".sonar/sonarqube-cli/tokens.json"
  ".config/configstore/firebase-tools.json"
  ".config/Bitwarden CLI"
  "Library/Application Support/Bitwarden CLI"
  ".agents/sessions"
  ".agentsview"
  ".private.fish"
  ".claude.json"
  ".databrickscfg"
  ".databricks"
  ".genie"
  ".config/acli"
  ".config/cf"
  ".vault-token"
-}}
{{- $workspaceFiles := list
  ".env"
  ".env.local"
  ".env.development"
  ".env.development.local"
  ".env.staging"
  ".env.production"
  ".env.production.local"
  ".env.test"
  ".env.test.local"
  ".npmrc"
  ".pypirc"
  ".netrc"
  "id_rsa"
  "id_ed25519"
  "id_ecdsa"
  "application_default_credentials.json"
-}}
{{- $metadataHosts := list
  "169.254.169.254"
  "metadata.google.internal"
  "metadata.goog"
  "100.100.100.200"
  "[fd00:ec2::254]"
-}}
{{- $rules := list -}}
{{- range $rel := $paths -}}
{{-   $rules = append $rules (printf "read_file(%s)" (joinPath $.chezmoi.homeDir $rel)) -}}
{{- end -}}
{{- /* Optional host-local credential paths from untracked ~/.config/chezmoi/chezmoi.toml [data]. */ -}}
{{- $extra := list -}}
{{- if and (hasKey . "extra_secret_denies") (ne (get . "extra_secret_denies") nil) -}}
{{-   $extra = get . "extra_secret_denies" -}}
{{- end -}}
{{- if not (kindIs "slice" $extra) }}{{ fail "extra_secret_denies must be an array" }}{{ end -}}
{{- range $entry := $extra -}}
{{-   if not (kindIs "string" $entry) }}{{ fail "extra_secret_denies entries must be strings" }}{{ end -}}
{{-   $rel := trim $entry -}}
{{-   if or (eq $rel "") (eq $rel ".") (eq $rel "/") (hasPrefix "~" $rel) (regexMatch "(^|/)\\.\\.(/|$)" $rel) (regexMatch "[*?\\[\\]()\\r\\n]" $rel) -}}
{{-     fail (printf "invalid extra_secret_denies path %q: use a concrete home-relative or absolute path without ~, .., globs, or parens" $entry) -}}
{{-   end -}}
{{-   $target := $rel -}}
{{-   if not (hasPrefix "/" $rel) -}}
{{-     $target = joinPath $.chezmoi.homeDir $rel -}}
{{-   end -}}
{{-   $rules = append $rules (printf "read_file(%s)" $target) -}}
{{- end -}}
{{- range $name := $workspaceFiles -}}
{{-   $rules = append $rules (printf "read_file(%s)" $name) -}}
{{- end -}}
{{- range $host := $metadataHosts -}}
{{-   $rules = append $rules (printf "read_url(%s)" $host) -}}
{{-   $rules = append $rules (printf "execute_url(%s)" $host) -}}
{{- end -}}
{{- toJson $rules -}}
