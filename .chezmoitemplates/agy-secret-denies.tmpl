{{- $spec := fromJson (includeTemplate "secret-deny-paths.tmpl" .) -}}
{{- $rules := list -}}
{{- range $rel := get $spec "paths" -}}
{{-   $rules = append $rules (printf "read_file(%s)" (joinPath $.chezmoi.homeDir $rel)) -}}
{{- end -}}
{{- range $glob := get $spec "globs" -}}
{{-   $rules = append $rules (printf "read_file(%s)" $glob) -}}
{{- end -}}
{{- toJson $rules -}}
