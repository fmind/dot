# Docs: https://www.chezmoi.io/reference/special-files/chezmoiignore/
# Preflight shared skill ownership while rendering source state, before forced apply can replace a package.
{{ includeTemplate "skill-catalog-check.tmpl" . }}

# Repository-only sources and tooling.
**/__pycache__
**/*.py[co]
.vale.ini
AGENTS.md
CHANGELOG.md
LICENSE
README.md
dot
dprint.json
install.sh
lefthook.yml
mise.lock
mise.toml
ruff.toml
skills
supagents.yaml
tests

# Machine-specific CLI configuration stays local.
.config/dot.yaml
.config/dot.*.yaml

# Machine-specific Git configuration stays local.
.config/git/config.*

# zsh is the macOS default login shell; Linux logins use .profile and .bashrc.
# Docker's Compose plugin path and macOS mise env overrides apply only on darwin; Linux keeps its own.
{{- if ne .chezmoi.os "darwin" }}
.config/mise/conf.d/macos.toml
.docker
.zprofile
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.config/systemd
systemd-user-reload.sh
{{- end }}

{{- if not (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt")) }}
.cache/huggingface/token
.config/bf/credentials
.config/dot/secrets
{{- end }}
