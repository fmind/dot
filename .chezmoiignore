# Docs: https://www.chezmoi.io/reference/special-files/chezmoiignore/
# Preflight shared skill ownership while rendering source state, before forced apply can replace a package.
{{ includeTemplate "skill-catalog-check.tmpl" . }}

# Generated artifacts use target-path patterns. chezmoi already skips dot-prefixed
# source entries, such as .venv and tool caches, at any depth.
**/*.py[co]
**/__pycache__
**/build
**/dist
**/htmlcov

# Repository-only sources and tooling. Supagents roles compile into native harness profiles.
.agents/supagents
AGENTS.md
CHANGELOG.md
LICENSE
README.md
dot
dprint.json
install.sh
lefthook.yml
mise.lock
mise.toml
ruff.toml
skills
supagents.yaml
trivy.yaml

# Personal dependency graphs are not part of the shared workstation baseline.
.config/mise/locks/mise.local

# Machine-specific CLI configuration stays local.
.config/dot.yaml
.config/dot.*.yaml

# Machine-specific Git configuration stays local.
.config/git/config.local
.config/git/config.*

# zsh is the macOS default login shell; Linux logins use .profile and .bashrc.
{{- if ne .chezmoi.os "darwin" }}
.zprofile
{{- end }}

# An existing Kaggle legacy/OAuth login must not acquire a higher-priority personal token.
{{- if or (stat (joinPath .chezmoi.homeDir ".kaggle/kaggle.json")) (stat (joinPath .chezmoi.homeDir ".kaggle/credentials.json")) }}
.kaggle/access_token
{{- end }}

{{- if ne .chezmoi.os "linux" }}
.local/share/applications/com.mitchellh.ghostty.desktop
{{- end }}

{{- if or (ne .chezmoi.os "linux") (not (stat "/opt/google/cros-containers/bin/notificationd")) (not (stat "/dev/wl0")) }}
.local/share/dbus-1/services/org.freedesktop.Notifications.service
{{- end }}

{{- if not (stat "/opt/google/cros-containers") }}
.config/systemd/user/cros-garcon.service.d
{{- end }}

{{- if not (stat (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt")) }}
.cache/huggingface/token
.kaggle/access_token
.local/share/opencode/auth.json
.config/bf/credentials
.config/dot/secrets
{{- end }}
