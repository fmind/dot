# Docs: https://www.chezmoi.io/reference/configuration-file/
encryption = "age"

[data]
    git_name = {{ promptStringOnce . "git_name" "What is your Git name" "Médéric Hurier (Fmind)" | quote }}
    git_email = {{ promptStringOnce . "git_email" "What is your Git email address" "github@fmind.dev" | quote }}
    github_user = {{ promptStringOnce . "github_user" "What is your GitHub username" "fmind" | quote }}
    git_personal_email = {{ promptStringOnce . "git_personal_email" "What Git email should personal repositories use" "github@fmind.dev" | quote }}

# Refuse to add an unencrypted file that contains a detected secret; use --encrypt.
[add]
    secrets = "error"

[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    recipient = "age1uvmlyuvm070d22xtmsadg9a0ucw49fyn4fx0fkd805lp3kd6zy0q745paz"

[cd]
    command = "fish"

[edit]
    apply = true
    command = {{ joinPath .chezmoi.homeDir ".local/bin/nvim-tty" | quote }}

[diff]
    # Diffs land in agent transcripts and logs; `chezmoi status` still flags encrypted drift.
    exclude = ["encrypted"]
    pager = "delta --paging=never"

[merge]
    command = {{ joinPath .chezmoi.homeDir ".local/bin/nvim-tty" | quote }}
    args = [
        "-d",
        "{{`{{ .Destination }}`}}",
        "{{`{{ .Source }}`}}",
        "{{`{{ .Target }}`}}"
    ]
