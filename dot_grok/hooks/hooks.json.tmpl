{{- $dot := includeTemplate "dot-bin.tmpl" . -}}
{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "{{ $dot }} agent hook notify grok needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(permission_prompt|elicitation_dialog)$"
      },
      {
        "hooks": [
          {
            "command": "{{ $dot }} agent hook notify grok ready",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^idle_prompt$"
      }
    ]
  }
}
