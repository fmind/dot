{{- /* Hooks name the CLI absolutely: a harness started without ~/.local/bin on PATH
       cannot resolve dot, or resolves Graphviz's /usr/bin/dot instead, and capture
       fails silently. */ -}}
{{- $dot := joinPath .chezmoi.homeDir ".local/bin/dot" -}}
{{- if not (regexMatch "^[A-Za-z0-9_@%+=:,./-]+$" $dot) }}{{ fail "home directory is not shell-safe for hook commands" }}{{ end -}}
{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "{{ $dot }} agent hook notify grok needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "permission_prompt"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "{{ $dot }} agent hook session grok",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "{{ $dot }} agent hook session grok",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "{{ $dot }} agent hook notify grok stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "{{ $dot }} agent hook session grok",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  }
}
