# chezmoi:modify-template
{{- /* Docs: https://mise.jdx.dev/getting-started.html#activate-mise
       .profile can also be sourced by POSIX login shells and desktop sessions; interactive bash
       activates mise through .bashrc, so this block only exposes the shims. */ -}}
{{- $path := `# Make mise-installed tools available to login shells and desktop sessions. Skip when
# .bashrc already ran: prepending again would put the shims ahead of mise activation.
case ":${PATH}:" in
  *":${HOME}/.local/share/mise/shims:"*) ;;
  *) export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/share/mise/bin:${HOME}/.local/bin:${PATH}" ;;
esac` -}}
{{- includeTemplate "managed-block.tmpl" (dict "stdin" .chezmoi.stdin "name" "mise-bash-integration" "body" $path "position" "bottom") -}}
