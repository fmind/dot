# chezmoi:modify-template
{{- /* Docs: https://mise.jdx.dev/getting-started.html#activate-mise
       .profile can also be sourced by POSIX login shells and desktop sessions. */ -}}
{{- $activation := `# Bootstrap mise for login shells; activation owns tool-version precedence.
export PATH="${HOME}/.local/share/mise/shims:${HOME}/.local/share/mise/bin:${HOME}/.local/bin:${PATH}"
# Claude Code snapshots this shell but not the hook state that mise() needs, which
# makes every mise call exit 127 there; its shells rely on the shims instead.
if [ -n "${BASH_VERSION:-}" ] && [ -z "${CLAUDECODE:-}" ] && command -v mise >/dev/null 2>&1; then
  mise_activation="$(mise activate bash)"
  eval "${mise_activation}"
fi` -}}
{{- includeTemplate "managed-block.tmpl" (dict "stdin" .chezmoi.stdin "name" "mise-bash-integration" "body" $activation "position" "bottom" "legacyEnd" "fi") -}}
