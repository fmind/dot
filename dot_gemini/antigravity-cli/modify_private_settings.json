# chezmoi:modify-template
{{- /* Docs: https://antigravity.google/docs/cli/settings
       Account and model choices belong to the host after initial setup; `dot trust`
       owns trustedWorkspaces. */ -}}
{{- $managedConfig := fromJson `
{
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "always-proceed",
  "editorMode": "vim",
  "notifications": true,
  "toolPermission": "always-proceed",
  "vimInsertFirst": true
}
` -}}
{{- $gcp_project := env "ANTIGRAVITY_CLOUD_PROJECT" -}}
{{- if $gcp_project -}}
{{- $_ := set $managedConfig "gcp" (dict "project" $gcp_project "location" (env "ANTIGRAVITY_CLOUD_LOCATION" | default "global")) -}}
{{- end -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" .chezmoi.stdin "defaults" dict "managed" $managedConfig) -}}
