# chezmoi:modify-template
{{- /* Docs: https://antigravity.google/docs/cli/settings
       Account, model, and trust choices belong to the host after initial setup. */ -}}
{{- $defaults := fromJson `
{
  "model": "Gemini 3.8 Flash (High)",
  "pickerGrouping": "grouped",
  "runningLightSpeed": "fast"
}
` -}}
{{- $_ := set $defaults "trustedWorkspaces" (list .chezmoi.homeDir (joinPath .chezmoi.homeDir ".local/share/chezmoi")) -}}
{{- $managedConfig := fromJson `
{
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "always-proceed",
  "colorScheme": "terminal",
  "editorMode": "vim",
  "notifications": true,
  "showFeedbackSurvey": false,
  "toolPermission": "always-proceed",
  "vimInsertFirst": true
}
` -}}
{{- $gcp_project := env "ANTIGRAVITY_CLOUD_PROJECT" -}}
{{- if $gcp_project -}}
{{- $_ := set $managedConfig "gcp" (dict "project" $gcp_project "location" (env "ANTIGRAVITY_CLOUD_LOCATION" | default "global")) -}}
{{- end -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" .chezmoi.stdin "defaults" $defaults "managed" $managedConfig) -}}
