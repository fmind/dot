# chezmoi:modify-template
{{- /* Docs: https://code.claude.com/docs/en/settings
       model and modelSettings are defaults rather than managed keys: they fill missing
       keys, then stay whatever /model and /effort last persisted. Effort is seeded per
       model because Opus 5.5 ignores the top-level effortLevel and starts at medium;
       levels stop at xhigh: max is session-only (/effort max).
       DISABLE_UPDATES blocks the auto-updater and `claude update`/`claude install`, leaving
       the version to mise, which installs latest; DISABLE_ERROR_REPORTING keeps error reports
       local.
       GIT_TERMINAL_PROMPT and CLOUDSDK_CORE_DISABLE_PROMPTS make git credential and gcloud
       prompts fail or take their default instead of waiting on a terminal no agent answers;
       the agy fish function sets CLOUDSDK_CORE_DISABLE_PROMPTS too, plus GH_PROMPT_DISABLED,
       for terminal and Remote Control sessions; other hosts expose no shell-environment setting.
       CLAUDE_CODE_FORCE_SESSION_PERSISTENCE keeps transcripts and resume entries when
       a terminal or launcher inherits CLAUDE_CODE_CHILD_SESSION from an earlier session.
       theme: light-ansi paints the TUI from the terminal's own sixteen slots,
       which is how fmind/theme reaches a tool that takes no theme file.
       disableClaudeAiConnectors keeps claude.ai connectors (Docs, Drive) out of every CLI session
       and subagent, with their tool names and server instructions; claude.ai still has them.
       syncClaudeAiSkills is false: ~/.claude/skills links to the shared ~/.agents/skills, so
       claude.ai skills synced into its synced/ folder would reach every other harness and
       exceed their discovery budget with Claude-only instructions.
       Provider selection (Vertex project, region, model overrides) stays in the ambient
       shell, so settings never leak project IDs or force Vertex across systems. */ -}}
{{- $dot := includeTemplate "dot-bin.tmpl" . -}}
{{- $defaults := dict "model" "fable" "modelSettings" (dict "claude-fable-5-1" (dict "effortLevel" "high") "claude-opus-5-5" (dict "effortLevel" "high")) -}}
{{- $managedConfig := fromJson (replace "@dot@" $dot `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoContinueAtUsageLimit": true,
  "disableClaudeAiConnectors": true,
  "editorMode": "vim",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1",
    "CLOUDSDK_CORE_DISABLE_PROMPTS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_UPDATES": "1",
    "GIT_TERMINAL_PROMPT": "0"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "feedbackSurveyRate": 0,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "@dot@ agent hook notify claude needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input)$"
      },
      {
        "hooks": [
          {
            "command": "@dot@ agent hook notify claude ready",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^idle_prompt$"
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "remoteControlAtStartup": true,
  "respectGitignore": false,
  "skillListingBudgetFraction": 0.02,
  "skipDangerousModePermissionPrompt": true,
  "syncClaudeAiSkills": false,
  "theme": "light-ansi",
  "tui": "fullscreen",
  "workflowSizeGuideline": "large",
  "worktree": {
    "baseRef": "head"
  }
}
`) -}}
{{- $current := dict -}}
{{- if ne (trim .chezmoi.stdin) "" }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- $directories := dig "permissions" "additionalDirectories" (list) $current -}}
{{- if not (kindIs "slice" $directories) }}{{ fail "permissions.additionalDirectories must be an array" }}{{ end -}}
{{- /* Add the managed roots (.agents, chezmoi, and pull.directories from ~/.config/dot.yaml)
       without replacing directories the host added. */ -}}
{{- /* Same default as PullConfig in dot/src/fmind_dot/config.py; test_harness_config keeps them equal. */ -}}
{{- $pullDirectories := list "~/fmind" "~/mlops-courses" -}}
{{- $dotConfigPath := joinPath .chezmoi.homeDir ".config/dot.yaml" -}}
{{- if stat $dotConfigPath -}}
{{-   $dotConfig := include $dotConfigPath | fromYaml -}}
{{-   if kindIs "map" $dotConfig -}}
{{-     $pullDirectories = dig "pull" "directories" $pullDirectories $dotConfig -}}
{{-   end -}}
{{- end -}}
{{- if not (kindIs "slice" $pullDirectories) }}{{ fail "pull.directories in ~/.config/dot.yaml must be an array" }}{{ end -}}
{{- $managedDirectories := list (joinPath .chezmoi.homeDir ".agents") (joinPath .chezmoi.homeDir ".local/share/chezmoi") -}}
{{- range $directory := $pullDirectories -}}
{{-   if not (kindIs "string" $directory) }}{{ fail "pull.directories entries in ~/.config/dot.yaml must be strings" }}{{ end -}}
{{-   if eq $directory "~" -}}
{{-     $managedDirectories = append $managedDirectories $.chezmoi.homeDir -}}
{{-   else if hasPrefix "~/" $directory -}}
{{-     $managedDirectories = append $managedDirectories (joinPath $.chezmoi.homeDir (trimPrefix "~/" $directory)) -}}
{{-   else if hasPrefix "/" $directory -}}
{{-     $managedDirectories = append $managedDirectories $directory -}}
{{-   else -}}
{{-     fail (printf "pull.directories entry %q in ~/.config/dot.yaml must start with ~/ or /" $directory) -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $managedConfig.permissions "additionalDirectories" (concat $directories $managedDirectories | uniq) -}}
{{- /* The brain's session-context hook joins host SessionStart hooks only where the brain is
       checked out. The entry is decoded from JSON so its integer matches the deployed one and
       uniq keeps a single copy; removing the brain later leaves the entry for the host to drop. */ -}}
{{- $sessionContext := joinPath .chezmoi.homeDir "fmind/brain/settings/hooks/session-context.py" -}}
{{- if stat $sessionContext -}}
{{-   $sessionStart := dig "hooks" "SessionStart" (list) $current -}}
{{-   if not (kindIs "slice" $sessionStart) }}{{ fail "hooks.SessionStart must be an array" }}{{ end -}}
{{-   $command := printf "%s %s" $sessionContext (joinPath .chezmoi.homeDir "fmind/brain") -}}
{{-   $entry := fromJson (printf `{"hooks": [{"type": "command", "command": %s, "timeout": 30}]}` (toJson $command)) -}}
{{-   $_ = set $managedConfig.hooks "SessionStart" (append $sessionStart $entry | uniq) -}}
{{- end -}}
{{- includeTemplate "config-merge.tmpl" (dict "stdin" .chezmoi.stdin "defaults" $defaults "managed" $managedConfig) -}}
