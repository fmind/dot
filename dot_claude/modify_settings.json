# chezmoi:modify-template
{{- /* model and modelSettings are defaults rather than managed keys: they seed a fresh
       file, then stay whatever /model and /effort last persisted. Effort is seeded per
       model because Opus 5.5 ignores the top-level effortLevel and starts at medium;
       levels stop at xhigh: max is session-only (/effort max).
       DISABLE_AUTOUPDATER leaves the version to mise, which installs latest.
       permissions.deny blocks the usual spelling of a few irreversible commands, even in
       bypass mode; it is a guardrail, not a boundary: other spellings still run.
       theme: light-ansi paints the TUI from the terminal's own sixteen slots,
       which is how fmind/theme reaches a tool that takes no theme file.
       enableAllProjectMcpServers is managed as false, not removed: the merge never
       deletes keys, so an already deployed true would otherwise keep auto-approving
       every repository-provided MCP server; enabledMcpjsonServers approves the owner's
       project servers by name instead; `dot trust` pre-accepts folder trust.
       PreCompact, SessionEnd, and SubagentStop stay managed as empty lists for the same
       reason: they clear retired session-capture hooks; `dot agent session sync` captures now.
       Provider-specific environment variables (CLAUDE_CODE_USE_VERTEX,
       ANTHROPIC_VERTEX_PROJECT_ID, CLOUD_ML_REGION, and model overrides) are
       retired so Claude routes dynamically via the ambient shell without leaking
       project IDs or forcing Vertex across systems. */ -}}
{{- $dot := includeTemplate "dot-bin.tmpl" . -}}
{{- $defaults := dict "model" "fable" "modelSettings" (dict "claude-fable-5-1" (dict "effortLevel" "high") "claude-opus-5-5" (dict "effortLevel" "high")) -}}
{{- $managedConfig := fromJson (replace "@dot@" $dot `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoContinueAtUsageLimit": true,
  "autoMemoryEnabled": true,
  "editorMode": "vim",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "brain"
  ],
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "feedbackSurveyRate": 0,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "@dot@ agent hook notify claude needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [],
    "SessionEnd": [],
    "Stop": [
      {
        "hooks": [
          {
            "command": "@dot@ agent hook notify claude stop",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": []
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "remoteControlAtStartup": true,
  "respectGitignore": false,
  "skillListingBudgetFraction": 0.02,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-ansi",
  "tui": "fullscreen",
  "workflowSizeGuideline": "large",
  "worktree": {
    "baseRef": "head"
  }
}
`) -}}
{{- $current := dict -}}
{{- if ne (trim .chezmoi.stdin) "" }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- $directories := dig "permissions" "additionalDirectories" (list) $current -}}
{{- if not (kindIs "slice" $directories) }}{{ fail "permissions.additionalDirectories must be an array" }}{{ end -}}
{{- /* Add the managed roots without replacing directories the host added. */ -}}
{{- $_ := set $managedConfig.permissions "additionalDirectories" (concat $directories (list (joinPath .chezmoi.homeDir ".agents") (joinPath .chezmoi.homeDir ".local/share/chezmoi") (joinPath .chezmoi.homeDir "fmind") (joinPath .chezmoi.homeDir "fmind-ai") (joinPath .chezmoi.homeDir "mlops-courses")) | uniq) -}}
{{- $deny := dig "permissions" "deny" (list) $current -}}
{{- if not (kindIs "slice" $deny) }}{{ fail "permissions.deny must be an array" }}{{ end -}}
{{- /* Add the managed rules without replacing rules the host added. A trailing *main also
       matches --force-with-lease and any remote. */ -}}
{{- $_ = set $managedConfig.permissions "deny" (concat $deny (list "Bash(rm -rf /)" "Bash(rm -rf ~)" "Bash(rm -rf ~/)" "Bash(rm -rf $HOME)" "Bash(git push --force *main)" "Bash(git push -f *main)") | uniq) -}}
{{- /* Retire provider environment variables so Claude Code switches between Vertex AI and subscription via ambient shell env without leaking project IDs into settings. */ -}}
{{- $input := .chezmoi.stdin -}}
{{- $env := dig "env" dict $current -}}
{{- $retireEnv := list "CLAUDE_CODE_USE_VERTEX" "ANTHROPIC_VERTEX_PROJECT_ID" "CLOUD_ML_REGION" "ANTHROPIC_DEFAULT_SONNET_MODEL" "ANTHROPIC_DEFAULT_HAIKU_MODEL" -}}
{{- $changed := false -}}
{{- range $key := $retireEnv -}}
{{-   if hasKey $env $key -}}
{{-     $_ := unset $env $key -}}
{{-     $changed = true -}}
{{-   end -}}
{{- end -}}
{{- if $changed -}}
{{-   $input = $current | toPrettyJson -}}
{{- end -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" $input "defaults" $defaults "managed" $managedConfig) -}}
