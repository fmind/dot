# chezmoi:modify-template
{{- /* model and effortLevel are defaults rather than managed keys: they seed a fresh
       file, then stay whatever /model and /effort last persisted.
       effortLevel stops at xhigh: max is session-only (/effort max), and an
       unknown value silently falls back to the default effort.
       theme: light-ansi paints the TUI from the terminal's own sixteen slots,
       which is how fmind/theme reaches a tool that takes no theme file.
       enableAllProjectMcpServers is managed as false, not removed: the merge never
       deletes keys, so an already deployed true would otherwise keep auto-approving
       every repository-provided MCP server; enabledMcpjsonServers approves the owner's
       project servers by name instead; `dot trust` pre-accepts folder trust.
       Hooks name the CLI absolutely: a harness started without ~/.local/bin on PATH
       cannot resolve dot, or resolves Graphviz's /usr/bin/dot instead, and capture
       fails silently. */ -}}
{{- $dot := joinPath .chezmoi.homeDir ".local/bin/dot" -}}
{{- if not (regexMatch "^[A-Za-z0-9_@%+=:,./-]+$" $dot) }}{{ fail "home directory is not shell-safe for hook commands" }}{{ end -}}
{{- $defaults := dict "effortLevel" "high" "model" "claude-fable-5-1[1m]" -}}
{{- $managedConfig := fromJson (replace "@dot@" $dot `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoContinueAtUsageLimit": true,
  "autoMemoryEnabled": true,
  "autoUpdatesChannel": "stable",
  "editorMode": "vim",
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "brain"
  ],
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000",
    "CLAUDE_AUTO_BACKGROUND_TASKS": "1"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "feedbackSurveyRate": 0,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "@dot@ agent hook notify claude needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "@dot@ agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "@dot@ agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "@dot@ agent hook notify claude stop",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "@dot@ agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "remoteControlAtStartup": true,
  "respectGitignore": false,
  "skillListingBudgetFraction": 0.02,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-ansi",
  "tui": "fullscreen",
  "workflowSizeGuideline": "large",
  "worktree": {
    "baseRef": "head"
  }
}
`) -}}
{{- $current := dict -}}
{{- if ne (trim .chezmoi.stdin) "" }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- $directories := dig "permissions" "additionalDirectories" (list) $current -}}
{{- if not (kindIs "slice" $directories) }}{{ fail "permissions.additionalDirectories must be an array" }}{{ end -}}
{{- /* Add the managed roots without replacing directories the host added. */ -}}
{{- $_ := set $managedConfig.permissions "additionalDirectories" (concat $directories (list (joinPath .chezmoi.homeDir ".agents") (joinPath .chezmoi.homeDir ".local/share/chezmoi") (joinPath .chezmoi.homeDir "fmind") (joinPath .chezmoi.homeDir "fmind-ai") (joinPath .chezmoi.homeDir "mlops-courses")) | uniq) -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" .chezmoi.stdin "defaults" $defaults "managed" $managedConfig) -}}
