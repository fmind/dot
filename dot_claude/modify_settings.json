# chezmoi:modify-template
{{- $managedConfig := fromJson `
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": true,
  "autoUpdatesChannel": "stable",
  "editorMode": "vim",
  "effortLevel": "xhigh",
  "enableAllProjectMcpServers": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1800000"
  },
  "feedbackSurveyRate": 0,
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "dot agent hook notify claude needs-input",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "dot agent hook notify claude stop",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "dot agent hook session claude",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "opus[1m]",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "respectGitignore": false,
  "skillListingBudgetFraction": 0.02,
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "head"
  }
}
` -}}
{{- $_ := set $managedConfig.permissions "additionalDirectories" (list (joinPath .chezmoi.homeDir ".agents") (joinPath .chezmoi.homeDir ".local/share/chezmoi") (joinPath .chezmoi.homeDir "fmind") (joinPath .chezmoi.homeDir "fmind-ai") (joinPath .chezmoi.homeDir "mlops-courses")) -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" .chezmoi.stdin "managed" $managedConfig "prune" (list "statusLine" "verbose" "viewMode" "promptSuggestionEnabled" "spinnerTipsEnabled"
      "advisorModel" "agentPushNotifEnabled" "alwaysThinkingEnabled" "autoCompactEnabled" "autoDreamEnabled"
      "fallbackModel" "fileCheckpointingEnabled" "precomputeCompactionEnabled" "showThinkingSummaries"
      "skillListingMaxDescChars" "skipWorkflowUsageWarning" "teammateDefaultModel" "todoFeatureEnabled"
      "useAutoModeDuringPlan" "workflowKeywordTriggerEnabled" "env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS"
      "env.MAX_MCP_OUTPUT_TOKENS" "env.TASK_MAX_OUTPUT_LENGTH")) -}}
