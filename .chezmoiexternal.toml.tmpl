# Docs: https://www.chezmoi.io/reference/special-files/chezmoiexternal-format/
# Follow upstream main; the apply task bypasses the cache with --refresh-externals.
{{ $base := "https://raw.githubusercontent.com/fmind/theme/main" }}

{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
{{ $fonts := ".local/share/fonts" -}}
{{ if eq .chezmoi.os "darwin" }}{{ $fonts = "Library/Fonts" }}{{ end -}}
["{{ $fonts }}/GoogleSans"]
    type = "archive"
    url = "https://github.com/googlefonts/googlesans/releases/download/v14.000/GoogleSans-v14.000.zip"
    checksum.sha256 = "d338f0e74f5eabead86a85b87edf4cc50cd6561196dbe173d1db4139e95b3ca7"
    stripComponents = 3
    include = ["build/GoogleSans/static/GoogleSans-*.ttf"]

["{{ $fonts }}/GoogleSans-OFL.txt"]
    type = "file"
    url = "https://raw.githubusercontent.com/googlefonts/googlesans/87ee3bfe8132b93d45ec49b2514eed2f47cd44c3/OFL.txt"
    checksum.sha256 = "831b6e041705873c3e6efb18c4c96202bc41c8be42a456d3d26c47abf14816d0"

["{{ $fonts }}/GoogleSansCodeOfficial"]
    type = "archive"
    url = "https://github.com/googlefonts/googlesans-code/releases/download/v7.001/GoogleSansCode-v7.001.zip"
    checksum.sha256 = "eebba2a438882396e8530cad6d6cb80182b0afb6e9e0ad07b7340359a53ba2e9"
    include = ["*.ttf", "OFL.txt"]
{{ end -}}

[".config/ghostty/themes/fmind"]
    type = "file"
    url = "{{ $base }}/ghostty/fmind"
    refreshPeriod = "24h"

[".config/zellij/themes/fmind.kdl"]
    type = "file"
    url = "{{ $base }}/zellij/fmind.kdl"
    refreshPeriod = "24h"

[".config/fish/conf.d/theme.fish"]
    type = "file"
    url = "{{ $base }}/fish/fmind.fish"
    refreshPeriod = "24h"

[".config/k9s/skins/theme.yaml"]
    type = "file"
    url = "{{ $base }}/k9s/fmind.yaml"
    refreshPeriod = "24h"

[".config/nvim/colors/fmind.lua"]
    type = "file"
    url = "{{ $base }}/nvim/colors/fmind.lua"
    refreshPeriod = "24h"

[".config/nvim/lua/lualine/themes/fmind.lua"]
    type = "file"
    url = "{{ $base }}/lualine/fmind.lua"
    refreshPeriod = "24h"

[".config/git/theme.gitconfig"]
    type = "file"
    url = "{{ $base }}/delta/fmind.gitconfig"
    refreshPeriod = "24h"

[".config/fzf/theme.conf"]
    type = "file"
    url = "{{ $base }}/fzf/fmind.conf"
    refreshPeriod = "24h"

[".config/opencode/themes/fmind.json"]
    type = "file"
    url = "{{ $base }}/opencode/fmind.json"
    refreshPeriod = "24h"

[".config/ptpython/theme.py"]
    type = "file"
    url = "{{ $base }}/ptpython/fmind.py"
    refreshPeriod = "24h"

[".config/atuin/themes/fmind.toml"]
    type = "file"
    url = "{{ $base }}/atuin/fmind.toml"
    refreshPeriod = "24h"

[".config/bat/themes/fmind.tmTheme"]
    type = "file"
    url = "{{ $base }}/bat/fmind.tmTheme"
    refreshPeriod = "24h"

[".config/lsd/colors.yaml"]
    type = "file"
    url = "{{ $base }}/lsd/fmind.yaml"
    refreshPeriod = "24h"

[".config/yazi/theme.toml"]
    type = "file"
    url = "{{ $base }}/yazi/fmind.toml"
    refreshPeriod = "24h"

# Install only the Mono family, keeping terminal icons within character cells.
{{ if eq .chezmoi.os "darwin" -}}
["Library/Fonts/GoogleSansCode"]
{{ else if eq .chezmoi.os "linux" -}}
[".local/share/fonts/GoogleSansCode"]
{{ end -}}
{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/GoogleSansCode.tar.xz"
    checksum.sha256 = "b5a2a79b6ac0f021049c63b67bb42a1dcf81d5bc4e447fc6205c79d969605f42"
    include = ["GoogleSansCodeNerdFontMono-*.ttf", "OFL.txt"]
{{ end -}}
