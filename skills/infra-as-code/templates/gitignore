# Docs: https://git-scm.com/docs/gitignore

# Provider binaries and module cache (re-created by `tofu init`)
.terraform/
# State never belongs in git: it stores every attribute, secrets included
*.tfstate
*.tfstate.*
# Plan artifacts and scratch output
tmp/
*.tfplan
# Variable files often hold credentials; commit only encrypted or example files
*.tfvars
*.tfvars.json
!*.example.tfvars
!*.example.tfvars.json
crash.log
crash.*.log
