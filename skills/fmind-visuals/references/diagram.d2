# Docs: https://d2lang.com/tour/classes/
# Fmind diagram theme — the standard palette for technical diagrams.
#
# Import it from a diagram source or copy its classes:
#
#   ...@path/to/diagram.d2
#
# Palette: https://github.com/fmind/theme/blob/main/README.md
# Use Google Sans for labels and Google Sans Code for code via D2 font flags.
# Keep the light canvas explicit when exporting for sites with light/dark modes.
style.fill: "#ffffff"
# Triple globs survive imports and style connections declared by the article.
(*** -> ***)[*].style: {
  stroke: "#174ea6"
  font-color: "#202124"
}

classes: {
  # A labelled boundary that holds other shapes: a platform, a layer, a zone.
  # Deliberately the quietest fill in the theme, because it is background for
  # everything nested inside it.
  group: {
    style: {
      fill: "#f1f3f4"
      stroke: "#9aa0a6"
      font-color: "#595d62"
      stroke-width: 2
    }
  }

  # A major building block the article names and discusses. This is the
  # workhorse class, so it carries the brand accent as its stroke.
  container: {
    style: {
      fill: "#d2e3fc"
      stroke: "#174ea6"
      font-color: "#202124"
      stroke-width: 2
    }
  }

  # A leaf part inside a container. Neutral on purpose: components are numerous,
  # and coloring them competes with the containers the reader is meant to track.
  component: {
    style: {
      fill: "#ffffff"
      stroke: "#9aa0a6"
      font-color: "#202124"
    }
  }

  # A human or a calling system — where the flow enters. The most saturated tint
  # in the theme, because there are few of them and the reader should find them
  # first. The text is ink rather than white on a solid fill for one measured
  # reason: `shape: person` draws its label on the canvas *below* the shape, not
  # inside it, so light-on-brand text renders invisible on the white surface.
  # Ink reads both inside the box and outside it.
  actor: {
    style: {
      fill: "#ceead6"
      stroke: "#0d652d"
      font-color: "#202124"
      stroke-width: 2
    }
  }

  # Something outside the boundary being described: a third-party API, a managed
  # service, another team's system. Dashed is the signal, not the color.
  external: {
    style: {
      fill: "#ffffff"
      stroke: "#9aa0a6"
      font-color: "#595d62"
      stroke-dash: 4
    }
  }

  # One numbered stage of a sequence or workflow.
  step: {
    style: {
      fill: "#feefc3"
      stroke: "#934900"
      font-color: "#202124"
    }
  }

  # Where a flow starts or stops. Brand ink, so an endpoint reads as a full stop.
  # This is the one class whose label must stay inside its shape: on a shape that
  # draws its label outside — `person`, `image` — white text lands on the white
  # canvas and disappears. Keep terminal a plain box.
  terminal: {
    style: {
      fill: "#202124"
      stroke: "#202124"
      font-color: "#ffffff"
    }
  }

}

# Classes communicate roles; reinforce them with labels, shape and line style.
# A whole system drawn as one box is a `container`. A rejected alternative is an
# `external` whose label says it was rejected. Add roles only for a demonstrated need.
