{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "REVISE", "BLOCK"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "id": { "type": "string" },
          "rule": { "type": "string" },
          "loc": { "type": "string" },
          "conf": { "type": "string", "enum": ["high", "med"] },
          "issue": { "type": "string" },
          "evidence": { "type": "string" },
          "fix": { "type": "string" }
        },
        "required": ["severity", "id", "rule", "loc", "conf", "issue", "evidence", "fix"]
      }
    },
    "deletions": { "type": "array", "items": { "type": "string" } },
    "unverified": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["verdict", "summary", "findings", "deletions", "unverified"]
}
