# Docs: https://packaging.python.org/en/latest/specifications/pyproject-toml/

[project]
name = "<slug>"
version = "0.1.0"
description = "<description>"
readme = "README.md"
requires-python = ">=<python_major_minor>"
license = "MIT"
license-files = ["LICENSE"]
authors = [{ name = "<holder>" }]
dependencies = []

[dependency-groups]
dev = [
  "deptry>=0.25.1",
  "mkdocstrings-python>=2.0.10",
  "pytest-cov>=7.1.0",
  "pytest-socket>=0.8.1",
  "pytest-timeout>=2.4.0",
  "pytest-watcher>=0.6.3",
  "pytest>=9.2.0",
  "ruff>=0.17.4",
  "ty>=0.0.99,<0.1", # pre-1.0: pin a compatible range until it stabilizes
  "validate-pyproject>=0.27",
  "zensical>=0.1.0,<0.2", # pre-1.0: pin a compatible range until it stabilizes
]

[build-system]
requires = ["uv_build>=0.13.0,<0.14"]
build-backend = "uv_build"

[tool.ruff]
line-length = 120
extend-exclude = ["*.md"] # dprint owns Markdown, including its Python blocks

[tool.ruff.format]
docstring-code-format = true
line-ending = "lf"

[tool.ruff.lint]
select = [
  "A",
  "ARG",
  "ASYNC",
  "B",
  "BLE",
  "C4",
  "DTZ",
  "E",
  "ERA",
  "F",
  "FURB",
  "I",
  "ISC",
  "LOG",
  "N",
  "PERF",
  "PGH",
  "PIE",
  "PLE",
  "PLW",
  "PT",
  "PTH",
  "Q",
  "RET",
  "RSE",
  "RUF",
  "S",
  "SIM",
  "SLF",
  "T10",
  "T20",
  "TID",
  "UP",
  "W",
]
ignore = [
  "E501", # line length allowed for HTML tags/templates
  "ASYNC240", # pathlib.Path methods allowed for small local checks
  "PLW0108", # unnecessary-lambda: style outside Ruff's default set
  "PLW2901", # redefined-loop-name: deliberate rebinding
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "T201"]

[tool.deptry]
# deptry does not infer uv_build's src/ layout when scanning `.`.
known_first_party = ["<package>"]

# Fix diagnostics at their source; never add blanket [tool.ty.rules] ignores.
[tool.ty.rules]
blanket-ignore-comment = "error" # require `ty: ignore[<rule>]`; PGH003 checks only `type: ignore`

[tool.pytest]
testpaths = ["tests"]
# Offline by default: tests reach only loopback and Unix sockets; test:integration passes --force-enable-socket.
addopts = ["-ra", "--allow-hosts=127.0.0.1,::1", "--allow-unix-socket"]
filterwarnings = ["error"]
markers = ["integration: requires local Docker and disposable external services"]
# Umbrella for strict_config, strict_markers, strict_xfail, and strict_parametrization_ids.
strict = true
# Fail a hung test instead of stalling the agent; a plugin string option rejects a bare TOML integer.
timeout = "60"

[tool.coverage.run]
branch = true
# Measure `python -m <package>` subprocess tests; drop once in-process tests cover the suite (sitecustomize slows subprocess-heavy runs).
patch = ["subprocess"]
source = ["<package>"]

[tool.coverage.report]
fail_under = 85
show_missing = true
skip_covered = true
skip_empty = true
