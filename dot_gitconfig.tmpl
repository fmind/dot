# Docs: https://git-scm.com/docs/git-config
[alias]
    a = add
    b = branch
    c = commit
    co = checkout
    cp = cherry-pick
    d = diff
    dt = difftool --dir-diff
    f = fetch
    l = log --oneline --graph --all
    m = merge
    p = push
    r = rebase
    s = status
    st = stash
    u = restore --staged
    w = switch

[advice]
    detachedHead = false
    statusHints = false

[branch]
    autoSetupMerge = inherit
    sort = -committerdate

[column]
    ui = auto

[commit]
    verbose = true

[core]
    autocrlf = input
    # Open nvim only on a terminal: agent shells have none, so a commit without -m or a
    # merge/rebase --continue keeps git's prepared message instead of hanging on nvim.
    editor = "f() { if [ -t 0 ] && [ -t 1 ]; then exec nvim \"$@\"; fi; }; f"
    pager = delta --paging=never

[delta]
    features = side-by-side
    line-numbers = true
    wrap-max-lines = unlimited

# Colours only. Fetched from github.com/fmind/theme by .chezmoiexternal.toml.tmpl,
# and included after [delta] so the theme owns syntax-theme and the diff styles
# while the block above keeps the behaviour settings.
[include]
    path = {{ joinPath .chezmoi.homeDir ".config/git/theme.gitconfig" | quote }}

[diff]
    algorithm = histogram
    colorMoved = zebra
    colorMovedWS = allow-indentation-change
    mnemonicPrefix = true
    tool = nvim

[difftool]
    prompt = false

# Neovim 0.12's built-in difftool: `git dt [<rev>]` opens every changed file side by side with
# a quickfix list. It opens the directories explicitly because with `-d` Snacks Explorer claims
# the directory buffers first. Git sets LOCAL and REMOTE as shell variables only, so the prefix
# exports them and the paths never word-split. nvim-tty fails fast in agent shells without a terminal.
[difftool "nvim"]
    cmd = LOCAL=\"$LOCAL\" REMOTE=\"$REMOTE\" {{ joinPath .chezmoi.homeDir ".local/bin/nvim-tty" }} -c \"packadd nvim.difftool\" -c \"lua require('difftool').open(vim.env.LOCAL, vim.env.REMOTE)\"

[fetch]
    all = true
    parallel = 0
    prune = true

[github]
    user = {{ .github_user | quote }}

[help]
    # Suggest only: `prompt` waits for y/N on a pseudo-terminal that agent harnesses never answer.
    autocorrect = 0

[init]
    defaultBranch = main

[interactive]
    diffFilter = delta --color-only --paging=never

[merge]
    conflictstyle = zdiff3

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current
    followTags = true
    # Refuse --force-with-lease when the remote tip was never integrated locally.
    useForceIfIncludes = true

[rebase]
    autoSquash = true
    autoStash = true
    instructionFormat = "[%an @ %ar] %s"
    missingCommitsCheck = warn
    updateRefs = true

[rerere]
    autoupdate = true
    enabled = true

[tag]
    sort = version:refname

[transfer]
    # Never store credentials embedded in a remote URL.
    credentialsInUrl = die
    fsckobjects = true

[url "git@github.com:"]
    pushInsteadOf = "https://github.com/"

[user]
    name = {{ .git_name | quote }}
    email = {{ .git_email | quote }}

# allowed_signers lists every machine's public key, so any machine verifies signatures locally.
[gpg "ssh"]
    allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" | quote }}
{{- $signingKey := joinPath .chezmoi.homeDir ".ssh/id_ed25519_signing" }}
{{- if stat $signingKey }}

# Sign commits and annotated tags with this machine's own SSH key (README: Commit signing);
# a machine without the key commits unsigned. The key has no passphrase so agent shells sign
# unattended. forceSignAnnotated signs `git tag NAME -m MSG` but leaves plain tags plain;
# an explicit -a opts out of signing.
[user]
    signingKey = {{ $signingKey | quote }}

[gpg]
    format = ssh

[commit]
    gpgSign = true

[tag]
    forceSignAnnotated = true
{{- end }}

# Git colours, fetched with the delta theme from the same pinned fmind/theme commit.
[include]
    path = {{ joinPath .chezmoi.homeDir ".config/git/colors.gitconfig" | quote }}

# Personal checkouts and this public source always commit with the personal address, even
# where user.email is a work address; machine-local configuration below still wins.
# Git resolves symlinks in a "~/" pattern (macOS /var, linked homes) but not in an absolute one.
{{- $source := printf "%s/" .chezmoi.sourceDir }}
{{- if hasPrefix (printf "%s/" .chezmoi.homeDir) $source }}{{ $source = printf "~/%s" (trimPrefix (printf "%s/" .chezmoi.homeDir) $source) }}{{ end }}
{{- range list $source "~/fmind/" }}
[includeIf {{ printf "gitdir:%s" . | quote }}]
    path = {{ joinPath $.chezmoi.homeDir ".config/git/personal.gitconfig" | quote }}
{{- end }}

# Include machine-local configuration and conditional profiles if present.
[include]
    path = {{ joinPath .chezmoi.homeDir ".config/git/config.local" | quote }}
