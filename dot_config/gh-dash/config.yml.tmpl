# yaml-language-server: $schema=https://gh-dash.dev/schema.json
# Docs: https://www.gh-dash.dev/configuration/

defaults:
  refetchIntervalMinutes: 10
  prApproveComment: ""
pager:
  diff: delta
repoPaths:
  # Absolute paths also work in quoted custom commands, where ~ is not expanded.
  ":owner/:repo": {{ joinPath .chezmoi.homeDir ":owner/:repo" | toJson }}
  "fmind/dot": {{ joinPath .chezmoi.homeDir ".local/share/chezmoi" | toJson }}
prSections:
  - title: Needs Review
    filters: "is:open review-requested:@me"
  - title: CI Red
    filters: "is:open author:@me status:failure"
  - title: Changes Requested
    filters: "is:open author:@me review:changes_requested"
  - title: Ready to Merge
    filters: "is:open author:@me review:approved status:success"
  - title: Involved
    filters: "is:open involves:@me -author:@me"
  - title: Drafts
    filters: "is:open author:@me draft:true"
issuesSections:
  - title: Assigned
    filters: "is:open assignee:@me"
  - title: Needs Human
    filters: "is:open label:needs-human"
  - title: Untriaged
    filters: "is:open -label:priority/p0 -label:priority/p1 -label:priority/p2"
  - title: In Progress
    filters: "is:open label:status/in-progress"
  - title: Involved
    filters: "is:open involves:@me"
keybindings:
  prs:
    - key: E
      name: review in octo
      command: >-
        nvim "+Octo https://github.com/{{`{{.RepoName}}`}}/pull/{{`{{.PrNumber}}`}}"
    - key: D
      name: full diff
      command: >-
        gh pr diff --repo {{`{{.RepoName}}`}} {{`{{.PrNumber}}`}} | delta --paging=always
    - key: O
      name: lazygit
      command: >-
        test -n "{{`{{.RepoPath}}`}}" && cd "{{`{{.RepoPath}}`}}" && lazygit
  issues:
    - key: E
      name: open in octo
      command: >-
        nvim "+Octo https://github.com/{{`{{.RepoName}}`}}/issues/{{`{{.IssueNumber}}`}}"
# Native theme block copied from fmind/theme.
# source: https://github.com/fmind/theme/blob/main/gh-dash/fmind.yml
# Update from gh-dash/fmind.yml after changing the upstream theme.
theme:
  colors:
    text:
      primary: '#202124'
      secondary: '#202124'
      inverted: '#ffffff'
      faint: '#595d62'
      warning: '#934900'
      error: '#a50e0e'
      success: '#0d652d'
      actor: '#174ea6'
    background:
      selected: '#d2e3fc'
    border:
      primary: '#174ea6'
      secondary: '#595d62'
      faint: '#595d62'
