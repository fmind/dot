// Docs: https://zellij.dev/documentation/layouts
// Alt z opens this tab: one 140-column pane centred between blank margins, so text on wide
// screens does not span the whole width. Ctrl p, f toggles the focused pane to full width.
// Terminals narrower than 140 columns cannot fit it: Zellij then opens an empty tab (Ctrl t, x closes it).
layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane split_direction="vertical" {
        // Margins wait on /dev/null to stay blank; Ctrl c in a margin closes it.
        pane name="margin" borderless=true command="tail" {
            args "-f" "/dev/null"
            close_on_exit true
        }
        // Exiting or closing this shell closes its own tab, margins included. Pane-run actions
        // have no focused tab, and a closed pane is gone before fish_exit runs, so the tab ID
        // is looked up at startup.
        pane size=140 focus=true command="fish" {
            args "-C" "set -g __zen_tab (zellij action list-panes --json | jq -r --argjson id $ZELLIJ_PANE_ID '.[] | select(.is_plugin == false and .id == $id) | .tab_id'); function __zen_close --on-event fish_exit; set -q __zen_tab[1]; and zellij action close-tab-by-id $__zen_tab; end"
            close_on_exit true
        }
        pane name="margin" borderless=true command="tail" {
            args "-f" "/dev/null"
            close_on_exit true
        }
    }
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
}
