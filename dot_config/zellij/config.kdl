// Docs: https://zellij.dev/documentation/configuration

default_shell "fish"
// Agent shells launch background sessions under TERM=dumb; every Zellij pane is a 256-color PTY.
env {
    TERM "xterm-256color"
}
theme "fmind"
// mise upgrades Zellij often; skip the release-notes screen after each upgrade.
show_release_notes false
// Skip the floating startup-tips pane in new sessions.
show_startup_tips false
// Prevent mouse scrolling from implicitly entering and exiting Scroll mode.
scroll_mode_sync false

// Keep pane OSC 9/777/99 alerts in Zellij's attention inbox without forwarding OS popups to Ghostty.
host_notification_protocol "off"

// Keep frame/tab attention markers and the on-demand Inbox, but skip the
// startup popup, global quiet-output noise, and standalone desktop popups.
attention {
    startup_card "never"
    idle_rule "watched"
    desktop_notifications {
        needs_you false
        failed false
        done false
    }
}

keybinds {
    // Alt bindings also work in Locked mode (Ctrl g) when an app needs the Ctrl keys.
    shared {
        // Through fish so the agy function (functions/agy.fish) sets the agent environment.
        bind "Alt a" { Run "fish" "-c" "agy" { close_on_exit true; }; }
        bind "Alt y" { Run "yazi" { floating true; close_on_exit true; x "10%"; y "10%"; width "80%"; height "80%"; }; }
        bind "Alt g" { Run "lazygit" { floating true; close_on_exit true; x "1%"; y "1%"; width "98%"; height "98%"; }; }
        bind "Alt /" { LaunchOrFocusPlugin "session-manager" { floating true; move_to_focused_tab true; }; }
        bind "Alt i" { GoToNextAttention; }
        bind "Alt Shift i" { ToggleSessionCard; }
    }
    shared_except "locked" {
        unbind "Ctrl h" // Conflicts with nvim
    }
    shared_except "move" {
        bind "Alt m" { SwitchToMode "Move"; }
    }
    move {
        bind "Alt m" { SwitchToMode "Normal"; }
    }
}
