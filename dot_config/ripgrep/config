# Docs: https://github.com/BurntSushi/ripgrep/blob/master/GUIDE.md#configuration-file

--glob=!.git/
--glob=!.mypy_cache/
--glob=!.pytest_cache/
--glob=!.ruff_cache/
--glob=!.terraform/
--glob=!.venv/
--glob=!__pycache__/
--glob=!node_modules/
--glob=!package-lock.json
--hidden
--smart-case

# Source: https://github.com/fmind/theme/blob/main/themes/ripgrep/fmind.ripgreprc
--colors=path:fg:17,78,166
--colors=path:style:bold
--colors=line:fg:89,93,98
--colors=column:fg:89,93,98
--colors=match:fg:32,33,36
--colors=match:bg:254,239,195
--colors=match:style:bold
