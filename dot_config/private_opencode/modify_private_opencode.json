# chezmoi:modify-template
{{- /* Docs: https://opencode.ai/v2/docs/config/
       Persona (symlinked AGENTS.md) and skills (~/.agents/skills) load natively; the theme
       lives in cli.json. 2.x runs no language servers (it ignores lsp), dropped compaction.prune,
       replaced autoupdate with update, and grants build/general broad tool access while keeping
       plan/explore read-only; retire legacy 1.x autoupdate, compaction, and permission. */ -}}
{{- $defaults := dict "model" "openrouter/google/gemini-4-hydrogen" "small_model" "openrouter/google/gemini-4-hydrogen" -}}
{{- $managedConfig := fromJson `
{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "update": "disable",
  "compaction": {"auto": true},
  "formatter": true
}
` -}}
{{- includeTemplate "config-merge.tmpl" (dict "stdin" .chezmoi.stdin "defaults" $defaults "managed" $managedConfig "replace" (list "autoupdate" "compaction" "permission") "format" "jsonc") -}}
