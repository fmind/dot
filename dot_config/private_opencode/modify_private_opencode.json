# chezmoi:modify-template
{{- /* Docs: https://opencode.ai/v2/docs/config/
       Persona (symlinked AGENTS.md) and skills (~/.agents/skills) load natively; the theme
       lives in cli.json. 2.x runs no language servers (it ignores lsp) and dropped compaction.prune, so
       compaction is replaced whole to retire it on every machine; the formatter is enabled. */ -}}
{{- $defaults := dict "model" "openrouter/google/gemini-4-hydrogen" "small_model" "openrouter/google/gemini-4-hydrogen" -}}
{{- $managedConfig := fromJson `
{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "compaction": {"auto": true},
  "formatter": true,
  "permission": "allow"
}
` -}}
{{- includeTemplate "config-merge.tmpl" (dict "stdin" .chezmoi.stdin "defaults" $defaults "managed" $managedConfig "replace" (list "compaction") "format" "jsonc") -}}
