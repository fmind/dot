# chezmoi:modify-template
{{- /* Docs: https://opencode.ai/docs/config/
       Persona (symlinked AGENTS.md) and skills (~/.agents/skills) load natively; the theme
       lives in cli.json. 2.x runs no language servers (it ignores lsp); pruning and the formatter are enabled. */ -}}
{{- $managedConfig := fromJson `
{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/google/gemini-3.8-flash",
  "small_model": "openrouter/google/gemini-3.8-flash",
  "share": "disabled",
  "autoupdate": false,
  "compaction": {"prune": true},
  "formatter": true,
  "permission": "allow"
}
` -}}
{{- includeTemplate "config-merge.tmpl" (dict "stdin" .chezmoi.stdin "managed" $managedConfig "format" "jsonc") -}}
