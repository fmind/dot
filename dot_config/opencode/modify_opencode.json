# chezmoi:modify-template
{{- $managedConfig := fromJson `
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.agents/AGENTS.md"],
  "model": "openrouter/google/gemini-3.8-flash",
  "small_model": "openrouter/google/gemini-3.8-flash",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "default_agent": "build",
  "share": "disabled",
  "snapshot": true,
  "autoupdate": "notify",
  "compaction": {"auto": true, "prune": true},
  "formatter": true,
  "lsp": true,
  "permission": "allow"
}
` -}}
{{- $_ := set $managedConfig "skills" (dict "paths" (list (joinPath .chezmoi.homeDir ".agents/skills"))) -}}
{{- /* Move the legacy managed theme to tui.json; preserve other host settings. */ -}}
{{- $current := dict -}}
{{- if ne (trim .chezmoi.stdin) "" }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- $input := .chezmoi.stdin -}}
{{- if hasKey $current "theme" -}}
{{-   $_ := unset $current "theme" -}}
{{-   $input = $current | toJson -}}
{{- end -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" $input "managed" $managedConfig) -}}
