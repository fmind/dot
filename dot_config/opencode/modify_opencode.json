# chezmoi:modify-template
{{- $managedConfig := fromJson `
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.agents/AGENTS.md"
  ],
  "model": "google-vertex/gemini-3.8-flash",
  "small_model": "google-vertex/gemini-3.8-flash",
  "provider": {
    "google-vertex": {
      "options": {
        "project": "{env:OPENCODE_GCP_PROJECT}",
        "location": "global"
      }
    }
  },
  "agent": {
    "build": {
      "steps": 100
    }
  },
  "autoupdate": "notify",
  "compaction": {
    "prune": true,
    "reserved": 300000
  },
  "experimental": {
    "batch_tool": true,
    "continue_loop_on_deny": true,
    "mcp_timeout": 60000
  },
  "formatter": true,
  "lsp": true,
  "watcher": {
    "ignore": [
      ".git/**",
      ".mypy_cache/**",
      ".ruff_cache/**",
      ".venv/**",
      "__pycache__/**",
      "node_modules/**"
    ]
  },
  "permission": "allow",
  "subagent_depth": 2,
  "tool_output": {
    "max_bytes": 262144,
    "max_lines": 5000
  }
}
` -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" .chezmoi.stdin "managed" $managedConfig) -}}
