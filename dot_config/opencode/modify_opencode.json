# chezmoi:modify-template
{
  {- $managedConfig := fromJson `
{
      "$schema": "https://opencode.ai/config.json",
      "instructions": [
        "~/.agents/AGENTS.md"
      ],
      "model": "google-vertex/gemini-3.8-flash",
      "small_model": "google-vertex/gemini-3.8-flash",
      "provider": {
        "google-vertex": {
          "options": {
            "project": "{env:OPENCODE_GCP_PROJECT}",
            "location": "global"
          }
        }
      },
      "agent": {
        "build": {
          "steps": 100
        },
        "plan": {
          "steps": 50
        }
      },
      "autoupdate": "notify",
      "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 300000
      },
      "experimental": {
        "batch_tool": true,
        "continue_loop_on_deny": true,
        "mcp_timeout": 120000
      },
      "formatter": true,
      "lsp": true,
      "watcher": {
        "ignore": [
          "*.egg-info/**",
          ".coverage/**",
          ".git/**",
          ".mypy_cache/**",
          ".pytest_cache/**",
          ".ruff_cache/**",
          ".venv/**",
          "__pycache__/**",
          "build/**",
          "dist/**",
          "node_modules/**"
        ]
      },
      "permission": "allow",
      "subagent_depth": 3,
      "tool_output": {
        "max_bytes": 524288,
        "max_lines": 5000
      }
    }
` -
  }
}
{
  {- $gcp_project := env "OPENCODE_GCP_PROJECT" | default (env "GOOGLE_CLOUD_PROJECT") -
  }
}
{
  {- if $gcp_project -
  }
}
{
  {-   $_ := set (index $managedConfig.provider "google-vertex").options "project" $gcp_project -
  }
}
{
  {- end -
  }
}
{
  {- $location := env "VERTEX_LOCATION" -
  }
}
{
  {- if $location -
  }
}
{
  {-   $_ := set (index $managedConfig.provider "google-vertex").options "location" $location -
  }
}
{
  {- end -
  }
}
{
  {- $_ := set $managedConfig "skills" (dict "paths" (list (joinPath .chezmoi.homeDir ".agents/skills"))) -
  }
}
{
  {- includeTemplate "json-merge.tmpl" (dict "stdin" .chezmoi.stdin "managed" $managedConfig) -
  }
}
