# chezmoi:modify-template
{{- $managedConfig := fromJson `
{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.agents/AGENTS.md"],
  "model": "google-vertex/gemini-3.8-flash",
  "small_model": "google-vertex/gemini-3.8-flash",
  "provider": {
    "google-vertex": {
      "options": {
        "project": "{env:OPENCODE_GCP_PROJECT}",
        "location": "global"
      }
    }
  },
  "autoupdate": "notify",
  "compaction": {"prune": true},
  "formatter": true,
  "lsp": true,
  "permission": "allow"
}
` -}}
{{- $gcp_project := env "OPENCODE_GCP_PROJECT" | default (env "GOOGLE_CLOUD_PROJECT") -}}
{{- if $gcp_project -}}
{{-   $_ := set (index $managedConfig.provider "google-vertex").options "project" $gcp_project -}}
{{- end -}}
{{- $location := env "VERTEX_LOCATION" -}}
{{- if $location -}}
{{-   $_ := set (index $managedConfig.provider "google-vertex").options "location" $location -}}
{{- end -}}
{{- $_ := set $managedConfig "skills" (dict "paths" (list (joinPath .chezmoi.homeDir ".agents/skills"))) -}}
{{- /* Restore native turn limits, compaction reserve and output handling.
       Retire only dot's overrides; preserve custom agents and MCP/provider settings. */ -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" .chezmoi.stdin "managed" $managedConfig
      "prune" (list "agent.build.steps" "agent.plan.steps" "compaction.auto"
        "compaction.reserved" "experimental.batch_tool" "experimental.continue_loop_on_deny"
        "experimental.mcp_timeout" "watcher.ignore" "subagent_depth"
        "tool_output.max_bytes" "tool_output.max_lines")) -}}
