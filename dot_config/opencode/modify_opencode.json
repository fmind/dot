# chezmoi:modify-template
{{- /* Docs: https://opencode.ai/docs/config/
       Persona (symlinked AGENTS.md) and skills (~/.agents/skills) load natively; the theme
       lives in tui.json. Python uses ty instead of pyright; pruning and the formatter are enabled. */ -}}
{{- $managedConfig := fromJson `
{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/google/gemini-3.8-flash",
  "small_model": "openrouter/google/gemini-3.8-flash",
  "share": "disabled",
  "autoupdate": false,
  "compaction": {"prune": true},
  "formatter": true,
  "lsp": {
    "pyright": {"disabled": true},
    "ty": {"command": ["ty", "server"], "extensions": [".py", ".pyi"]}
  },
  "permission": "allow"
}
` -}}
{{- includeTemplate "json-merge.tmpl" (dict "stdin" .chezmoi.stdin "managed" $managedConfig "jsonc" true) -}}
