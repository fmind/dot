text := import("text")

strip_blockquote := func(s) {
  cur := text.trim_left(s, " \t")
  for text.has_prefix(cur, ">") {
    cur = text.trim_left(cur[1:], " \t")
  }
  return cur
}

fence_run := func(s) {
  if len(s) < 3 {
    return {ch: "", n: 0, rest: s}
  }
  ch := s[0:1]
  if ch != "`" && ch != "~" {
    return {ch: "", n: 0, rest: s}
  }
  i := 0
  for i < len(s) && s[i:i+1] == ch {
    i += 1
  }
  if i < 3 {
    return {ch: "", n: 0, rest: s}
  }
  return {ch: ch, n: i, rest: s[i:]}
}

count_code_spans := func(s) {
  n := len(s)
  i := 0
  spans := 0
  for i < n {
    if s[i:i+1] != "`" {
      i += 1
      continue
    }
    open_len := 0
    for i < n && s[i:i+1] == "`" {
      open_len += 1
      i += 1
    }
    j := i
    closed := false
    for j < n {
      if s[j:j+1] != "`" {
        j += 1
        continue
      }
      close_len := 0
      for j < n && s[j:j+1] == "`" {
        close_len += 1
        j += 1
      }
      if close_len == open_len {
        spans += 1
        i = j
        closed = true
        break
      }
    }
    if !closed {
      break
    }
  }
  return spans
}

strip_html_comments := func(s, in_comment) {
  n := len(s)
  i := 0
  out := ""
  for i < n {
    if in_comment {
      if i+3 <= n && s[i:i+3] == "-->" {
        in_comment = false
        i += 3
      } else {
        i += 1
      }
      continue
    }
    if s[i:i+1] == "`" {
      start := i
      open_len := 0
      for i < n && s[i:i+1] == "`" {
        open_len += 1
        i += 1
      }
      j := i
      closed := false
      for j < n {
        if s[j:j+1] != "`" {
          j += 1
          continue
        }
        close_len := 0
        for j < n && s[j:j+1] == "`" {
          close_len += 1
          j += 1
        }
        if close_len == open_len {
          out += s[start:j]
          i = j
          closed = true
          break
        }
      }
      if !closed {
        out += s[start:n]
        break
      }
      continue
    }
    if i+4 <= n && s[i:i+4] == "<!--" {
      in_comment = true
      i += 4
      continue
    }
    out += s[i:i+1]
    i += 1
  }
  return {text: out, in_comment: in_comment}
}

matches := []
lines := text.split(scope, "\n")
in_frontmatter := false
in_fence := false
in_comment := false
fence_char := ""
fence_len := 0
offset := 0

for idx, line in lines {
  raw_trim := text.trim_space(line)
  if idx == 0 && raw_trim == "---" {
    in_frontmatter = true
    offset += len(line) + 1
    continue
  }
  if in_frontmatter {
    if raw_trim == "---" || raw_trim == "..." {
      in_frontmatter = false
    }
    offset += len(line) + 1
    continue
  }

  unquoted := strip_blockquote(line)
  trimmed := text.trim_space(unquoted)
  run := fence_run(trimmed)

  if in_fence {
    if run.ch == fence_char && run.n >= fence_len && text.trim_space(run.rest) == "" {
      in_fence = false
      fence_char = ""
      fence_len = 0
    }
  } else if !in_comment && run.n >= 3 && (run.ch == "~" || !text.contains(run.rest, "`")) {
    in_fence = true
    fence_char = run.ch
    fence_len = run.n
  } else {
    stripped := strip_html_comments(unquoted, in_comment)
    in_comment = stripped.in_comment
    cleaned := stripped.text
    clean_trim := text.trim_space(cleaned)
    if clean_trim != "" && !text.has_prefix(clean_trim, "|") && !text.has_prefix(clean_trim, "#") {
      if count_code_spans(cleaned) >= 3 {
        matches = append(matches, {begin: offset, end: offset + len(line)})
      }
    }
  }
  offset += len(line) + 1
}
