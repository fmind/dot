{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Docs: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      // Source: https://github.com/fmind/theme/blob/main/themes/fastfetch/fmind.json
      "keys": "blue",
      "title": "green"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "host",
    "uptime",
    "shell",
    {
      "type": "terminal",
      "key": "Term"
    },
    "cpu",
    "memory",
    {
      "type": "disk",
      "key": "Disk"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
