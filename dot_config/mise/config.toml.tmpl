# :schema https://mise.jdx.dev/schema/mise.json
# Docs: https://mise.jdx.dev/configuration.html

[settings]
# Signature/provenance verification (cosign, minisign, SLSA, GitHub attestations)
# is deliberately off across every backend: upstream attestation coverage is too
# patchy to gate routine upgrades on, and this is a single-user workstation. The
# lockfile records digests for aqua/github/http downloads and conda dependencies.
# Newly published releases are eligible immediately. Format 2 records supported
# npm and pipx dependency graphs in locks/; keep these native files with mise.lock
# and install with --locked. Registry tools such as gcloud may still pin only a version.
# First fetches are unverified.
aqua.cosign = false
aqua.github_attestations = false
aqua.minisign = false
aqua.slsa = false
# Interactive prompts draw from the terminal's sixteen slots rather than from
# mise's own palette, so they follow fmind/theme like everything else.
color_theme = "base16"
# asdf plugins lock without checksums and may compile from source; registry tools
# must resolve to aqua, conda, github, or vfox instead.
disable_backends = ["asdf"]
env_cache = true
# `gh` stores its token in the system keyring, so mise's default gh_cli_tokens
# fallback (which parses ~/.config/gh/hosts.yml) finds nothing and hits the GitHub
# API unauthenticated: 60 req/h, which `mise upgrade` blows through in 429 storms.
# Shelling out to `gh auth token` keeps the token out of the dotfiles and out of the
# process environment, at the cost of one `gh` invocation per token lookup.
github.credential_command = "gh auth token"
github.github_attestations = false
github.slsa = false
github_attestations = false
lockfile = true
lockfile_platforms = ["linux-x64", "macos-arm64"]
# Resolve fuzzy versions such as `latest` without a release-age delay.
minimum_release_age = "0d"
slsa = false
# Trust is machine-local: use `mise trust` for individual configs or keep
# trusted_config_paths in unmanaged ~/.config/mise/conf.d/trust.toml.

[tool_alias]
fish = "aqua:fish-shell/fish-shell"
# The registry default (vfox) locks release URLs without digests; aqua locks checksums.
neovim = "aqua:neovim/neovim"

[settings.hook_env]
chpwd_only = true

[env]
ASTRO_TELEMETRY_DISABLED = "1"

[tools]
"aqua:dlvhdr/gh-dash" = "latest" # TUI dashboard for GitHub PRs, issues, and notifications
"aqua:github/copilot-cli" = "latest" # GitHub Copilot terminal-based AI coding agent CLI
# "aqua:slackapi/slack-cli" = "latest" # Slack app builder; needs a workspace where you can install apps
"conda:file" = "latest" # File type detection required by Yazi; includes its magic database
"github:databricks/cli" = "latest" # Databricks command-line interface for Asset Bundles, Lakeflow, and Unity Catalog
"npm:@mermaid-js/mermaid-cli" = { version = "latest", allow_builds = ["puppeteer"] } # Allow Puppeteer to install the headless browser used for rendering
"npm:skills" = "latest" # Agent Skills CLI manager
"pipx:aws-sso-util" = "latest" # Utilities for AWS SSO/IAM Identity Center authentication
{{ if stat (joinPath .chezmoi.homeDir ".local/share/brain-framework/11.0.0/.venv/bin/bf") -}}
# Published 11.0.0 (format 5) in a local runtime with its own uv.lock and verified wheel.
"pipx:brain-framework" = "path:{{ .chezmoi.homeDir }}/.local/share/brain-framework/11.0.0/.venv"
{{ else if stat (joinPath .chezmoi.homeDir ".local/share/brain-framework/10.0.0/.venv/bin/bf") -}}
# Published format-4 release kept for rollback; this runtime has its own uv.lock and wheel.
"pipx:brain-framework" = "path:{{ .chezmoi.homeDir }}/.local/share/brain-framework/10.0.0/.venv"
{{ else -}}
"pipx:brain-framework" = "latest" # Brain Framework CLI (bf)
{{ end -}}
"pipx:copier" = "latest" # Default project template generator and updater
"pipx:fmind" = "latest" # Fmind portfolio reader; renders www.fmind.dev from the terminal
# google-colab-cli >=0.7.2 pins jupyter-kernel-client==0.8 itself, so the former `with` pin
# (against 1.0.0's KernelClient rename) is obsolete and would conflict (verified 2026-09-24).
"pipx:google-colab-cli" = "latest" # CLI client for Google Colab
"pipx:huggingface_hub" = "latest" # Hugging Face Hub CLI client
"pipx:kaggle" = "latest" # Kaggle dataset and competition CLI
"pipx:pgcli" = { version = "latest", with = ["psycopg[binary]"] } # PostgreSQL client with bundled libpq; no host package needed
"pipx:pip-audit" = "latest" # Audits installed pipx tool environments for check:vuln:tools; uv-managed projects use `uv audit` for check:vuln
"pipx:ptpython" = "latest" # Interactive Python REPL with autocomplete
acli = "latest" # Atlassian CLI for Jira and Confluence from the terminal
actionlint = "latest" # Correctness linter for GitHub Actions workflows
age = "latest" # Simple and secure file encryption tool
ast-grep = "latest" # Code structural search, lint, and rewrite tool
astro = "latest" # Astronomer CLI for local Apache Airflow development and DAG testing
awscli = "latest" # Official Amazon Web Services command-line interface
bat = "latest" # Cat clone with syntax highlighting and git integration
bitwarden = "latest" # Official Bitwarden CLI (bw) for password management
bottom = "latest" # Graphical system and process monitor for terminal
carapace = "latest" # Multi-shell command argument completion generator
chezmoi = "latest" # Dotfiles manager across diverse machines
claude = "latest" # Claude Code terminal-based AI coding agent CLI
codex = "latest" # OpenAI Codex terminal-based AI coding agent CLI
cosign = "latest" # Sign and verify container images and attestations (Sigstore)
d2 = "latest" # Text-to-diagram language for bespoke standalone compositions
delta = "latest" # Syntax-highlighter for git, diff, and grep output
doggo = "latest" # Command-line DNS client supporting modern protocols
dprint = "latest" # Pluggable and ultra-fast code formatter
duckdb = "latest" # Embedded SQL analytical database management system
duf = "latest" # Disk usage utility with clean tabular layout
dust = "latest" # Rust-based disk usage analyzer
dyff = "latest" # Semantic diff for YAML/JSON (Kubernetes-aware)
fastfetch = "latest" # Active, customizable system info fetching tool
fd = "latest" # Simple, fast replacement for the find command
fish = "latest" # Friendly interactive shell (Fish)
fzf = "latest" # Interactive general-purpose fuzzy finder
gcloud = "latest" # Google Cloud SDK command-line utility
gh = "latest" # GitHub official command-line tool
git-cliff = "latest" # Generate changelogs from Conventional Commits
git-lfs = "latest" # Git Large File Storage helper
gitleaks = "latest" # Audits git repositories for secrets and keys
hadolint = "latest" # Dockerfile linter written in Haskell
helm = "latest" # Package manager for Kubernetes charts
hyperfine = "latest" # Command-line benchmarking utility
jq = "latest" # Command-line JSON processor
k3d = "latest" # Run lightweight k3s Kubernetes clusters in Docker
k9s = "latest" # Terminal UI for viewing Kubernetes clusters
kube-linter = "latest" # Static analysis linter for Kubernetes YAML/Helm
kubeconform = "latest" # Kubernetes manifest schema validator
kubectl = "latest" # Command-line tool to control Kubernetes clusters
kustomize = "latest" # Customizes raw Kubernetes YAML configurations
lazydocker = "latest" # Terminal UI for managing Docker containers
lazygit = "latest" # Terminal UI for Git commands
lefthook = "latest" # Fast and powerful Git hooks runner
lsd = "latest" # Modern, feature-rich replacement for ls
lychee = "latest" # Fast link checker for Markdown, HTML, and websites
neovim = "latest" # Extensible Vim-based text editor
