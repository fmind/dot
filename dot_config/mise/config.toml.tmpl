# :schema https://mise.jdx.dev/schema/mise.json
# Docs: https://mise.jdx.dev/configuration.html

[settings]
# Signature/provenance verification (cosign, minisign, SLSA, GitHub attestations)
# is deliberately off across every backend, and releases are installed the day they
# ship. The trade-off: mise.lock records a digest only for the aqua/github/http
# backends, so a *re-install* of those is reproducible -- the `cargo:`, `npm:` and `pipx:`
# entries (plus registry tools such as gcloud, make, neovim, sqlite and uv) pin a
# version but no digest, and the first fetch of any new version is unverified. Upstream
# attestation coverage is too patchy to gate routine upgrades on, and this is a
# single-user workstation. Raise minimum_release_age (e.g. "3d") to trade upgrade
# latency for a window in which a compromised release gets pulled.
aqua.cosign = false
aqua.github_attestations = false
aqua.minisign = false
aqua.slsa = false
# Compile Tree-sitter locally: upstream Linux binaries require GLIBC 2.39.
cargo.binstall = false
env_cache = true
# `gh` stores its token in the system keyring, so mise's default gh_cli_tokens
# fallback (which parses ~/.config/gh/hosts.yml) finds nothing and hits the GitHub
# API unauthenticated: 60 req/h, which `mise upgrade` blows through in 429 storms.
# Shelling out to `gh auth token` keeps the token out of the dotfiles and out of the
# process environment, at the cost of one `gh` invocation per token lookup.
github.credential_command = "gh auth token"
github.github_attestations = false
github.slsa = false
github_attestations = false
lockfile = true
lockfile_platforms = ["linux-x64", "macos-arm64"]
minimum_release_age = "0d"
slsa = false

[tool_alias]
d2 = "aqua:d2lang/d2"
fish = "aqua:fish-shell/fish-shell"
tree-sitter = "cargo:tree-sitter-cli"

[settings.hook_env]
chpwd_only = true

[tools]
"aqua:dlvhdr/gh-dash" = "latest" # TUI dashboard for GitHub PRs, issues, and notifications
"aqua:github/copilot-cli" = "latest" # GitHub Copilot terminal-based AI coding agent CLI
