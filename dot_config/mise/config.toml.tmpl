starship = "latest" # Minimal and customizable cross-shell prompt
# step = "latest" # Tool for automating PKI and certificate management (unused)
stern = "latest" # Multi-pod and multi-container log tailing for Kubernetes
stylua = "latest" # Opinionated Lua formatter
terraform-docs = "latest" # Generate documentation from Terraform modules
tflint = "latest" # Terraform code linter
tree-sitter = "latest" # Parser generator CLI backing nvim-treesitter; Linux binary requires glibc 2.39+
trivy = "latest" # Security vulnerability and secret scanner
ttyd = { version = "latest", os = ["linux"] } # VHS terminal backend; upstream binaries are Linux-only
ty = "latest" # Astral's high-performance Python type checker
uv = "latest" # Astral's high-performance Python package installer
usage = "latest" # Specification and completion tool for CLIs (powers mise completions)
