opengrep = "latest" # Semantic SAST with cross-function taint analysis (check:sast)
opentofu = "latest" # OpenTofu infrastructure as code CLI (open-source Terraform fork, default)
python = "latest" # Python programming language interpreter
ripgrep = "latest" # Blazing-fast grep alternative
