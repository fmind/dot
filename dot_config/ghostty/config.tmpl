# Docs: https://ghostty.org/docs/config/reference

theme = {{ .theme_variant }}

# Font Configs
font-family = "FiraCode Nerd Font Mono"
font-feature = -calt
font-feature = -liga
font-size = 13
# FiraCode ships no italic face at all, so Ghostty would synthesise one by
# slanting upright glyphs. The theme separates roles with bold and dim instead.
font-synthetic-style = no-italic,no-bold-italic
# The palette spends all sixteen slots on distinct syntax roles, so the bright
# half is not a lightened copy of the normal half: bold-is-bright would silently
# swap six semantic colours for six others.
bold-is-bright = false

{{- if eq .chezmoi.os "darwin" }}
macos-option-as-alt = left
{{- end }}

# Quality of Life
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard
cursor-click-to-move = true
mouse-shift-capture = false
window-save-state = always

# Performance Improvements
cursor-style-blink = false
mouse-hide-while-typing = true
resize-overlay = never
quick-terminal-animation-duration = 0
custom-shader-animation = false
{{- if eq .chezmoi.os "linux" }}
gtk-single-instance = true
linux-cgroup = never
{{- end }}

# Zellij & Shell Integration
shell-integration-features = true

# Launch fish through the mise shim
command = {{ .chezmoi.homeDir }}/.local/share/mise/shims/fish
