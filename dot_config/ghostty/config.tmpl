# Docs: https://ghostty.org/docs/config/reference

theme = fmind
# Match Linux window chrome to the terminal background; use light chrome on macOS.
window-theme = {{ if eq .chezmoi.os "linux" }}ghostty{{ else }}light{{ end }}

# Font Configs
font-family = "GoogleSansCode Nerd Font Mono"
font-feature = -calt
font-feature = -liga
font-size = 14
# Use the font's real italic faces when requested; never synthesise slanted glyphs.
# The theme uses upright text and bold for structure.
font-synthetic-style = no-italic,no-bold-italic
# Preserve foreground colour when applications request bold.
bold-is-bright = false

{{- if eq .chezmoi.os "darwin" }}
macos-option-as-alt = left
{{- end }}

# Quality of Life
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard
cursor-click-to-move = true
mouse-shift-capture = false
window-save-state = always

# Performance Improvements
cursor-style-blink = false
mouse-hide-while-typing = true
resize-overlay = never
quick-terminal-animation-duration = 0
custom-shader-animation = false
{{- if eq .chezmoi.os "linux" }}
gtk-single-instance = true
linux-cgroup = never
{{- end }}

# Zellij & Shell Integration
shell-integration-features = true

# Launch fish through the mise shim
command = {{ .chezmoi.homeDir }}/.local/share/mise/shims/fish
