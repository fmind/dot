# Docs: https://ghostty.org/docs/config/reference

theme = fmind
# Keep arbitrary ANSI background combinations readable, including older theme downloads.
minimum-contrast = 4.5
# Match Linux window chrome to the terminal background; use light chrome on macOS.
window-theme = {{ if eq .chezmoi.os "linux" }}ghostty{{ else }}light{{ end }}

# Font Configs
font-family = "GoogleSansCode Nerd Font Mono"
font-feature = -calt
font-feature = -liga
font-size = 14
# Use the font's real italic faces when requested; never synthesise slanted glyphs.
# The theme uses upright text and bold for structure.
font-synthetic-style = no-italic,no-bold-italic

{{- if eq .chezmoi.os "darwin" }}
macos-option-as-alt = left
{{- end }}

# Quality of Life
copy-on-select = clipboard
# Compensate for fast Zellij scrolling on Linux; retain the macOS tuning.
{{ if eq .chezmoi.os "linux" }}
mouse-scroll-multiplier = precision:0.0625,discrete:0.25
{{ else }}
mouse-scroll-multiplier = precision:0.25,discrete:1
{{ end }}
window-save-state = always

# Performance Improvements
cursor-style-blink = false
mouse-hide-while-typing = true
resize-overlay = never
quick-terminal-animation-duration = 0
custom-shader-animation = false
{{- if eq .chezmoi.os "linux" }}
gtk-single-instance = true
linux-cgroup = never
{{- end }}

# Zellij & Shell Integration
shell-integration-features = true

# Launch fish through the mise shim
command = {{ .chezmoi.homeDir }}/.local/share/mise/shims/fish
