# Docs: https://ghostty.org/docs/config/reference

theme = fmind
window-theme = {{ if eq .chezmoi.os "linux" }}ghostty{{ else }}light{{ end }}

font-family = "GoogleSansCode Nerd Font Mono"
font-feature = -calt
font-feature = -liga
font-size = 14
# Never synthesize slanted glyphs; use real italic faces only.
font-synthetic-style = no-italic,no-bold-italic

{{- if eq .chezmoi.os "darwin" }}
macos-option-as-alt = left
window-save-state = always
{{- end }}

copy-on-select = clipboard
# Compensate for fast Zellij scrolling on Linux.
{{- if eq .chezmoi.os "linux" }}
mouse-scroll-multiplier = precision:0.0625,discrete:0.25
{{- else }}
mouse-scroll-multiplier = precision:0.25,discrete:1
{{- end }}

cursor-style-blink = false
mouse-hide-while-typing = true
resize-overlay = never
{{- if eq .chezmoi.os "linux" }}
gtk-single-instance = true
linux-cgroup = never
{{- end }}

command = {{ joinPath .chezmoi.homeDir ".local/share/mise/shims/fish" | quote }}
