# https://www.freedesktop.org/software/systemd/man/latest/systemd.service.html
[Unit]
Description=Collect due FKF sources of the bases trusted on this machine

[Service]
Type=oneshot
WorkingDirectory=%h
# mise supplies fkf and the provider CLIs (git, gh, gws) that collectors call.
ExecStart=%h/.local/bin/mise exec -- fkf update
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal
