# Docs: https://www.freedesktop.org/software/systemd/man/latest/systemd.service.html
# Nightly restart only when ~/.local/bin/agy was updated since the daemon started (restarts abort active tasks).
[Unit]
Description=Restart agy's remote-control daemon if it runs an outdated binary

[Service]
Type=oneshot
# stat -L follows /proc/PID/exe even if unlinked; compare device:inode (`$$` and `%%` escape systemd).
ExecStart=/bin/sh -c 'pid=$$(systemctl --user show -p MainPID --value antigravity-cli-daemon.service); [ "$${pid:-0}" -gt 0 ] || exit 0; proc_id=$$(stat -Lc %%d:%%i /proc/$$pid/exe 2>/dev/null) && [ -n "$$proc_id" ] || exit 0; bin_id=$$(stat -Lc %%d:%%i %h/.local/bin/agy 2>/dev/null) && [ -n "$$bin_id" ] || exit 0; [ "$$proc_id" = "$$bin_id" ] || exec systemctl --user try-restart antigravity-cli-daemon.service'
