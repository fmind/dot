# Docs: https://www.freedesktop.org/software/systemd/man/latest/systemd.timer.html
[Unit]
Description=Nightly check that agy's remote-control daemon runs the current binary

[Timer]
OnCalendar=*-*-* 04:30:00
# Non-persistent: never fire mid-workday after wake/reboot (restarts abort active tasks).
Persistent=false

[Install]
WantedBy=timers.target
