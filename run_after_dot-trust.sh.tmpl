#!/bin/sh
# Pre-accept coding-harness folder trust for the configured workspaces, their
# repositories, and this source directory, and add those repositories to agy's
# Remote Control projects; `dot trust` only adds missing entries.
set -eu
dot={{ joinPath .chezmoi.homeDir ".local/bin/dot" | shellQuote }}
# Bare apply can precede installation; `mise run full` defers hooks until dot is deployed.
[ -x "${dot}" ] || exit 0
# One call pays the CLI startup once.
"${dot}" trust all {{ .chezmoi.sourceDir | shellQuote }} >/dev/null
