# Docs: https://specifications.freedesktop.org/desktop-entry-spec/latest/
{{- /* Crostini without GPU support (no /dev/dri) needs software rendering; with crostini-gpu-support, and on native Linux desktops, Ghostty keeps its GPU path. */}}
{{- $exec := "ghostty" }}
{{- if and (stat "/opt/google/cros-containers") (not (stat "/dev/dri")) }}{{ $exec = print "env GDK_BACKEND=x11 GSK_RENDERER=cairo LIBGL_ALWAYS_SOFTWARE=1 " $exec }}{{ end }}
[Desktop Entry]
Name=Ghostty
Type=Application
Comment=A terminal emulator
Exec={{ $exec }}
Icon=com.mitchellh.ghostty
Categories=System;TerminalEmulator;
Keywords=terminal;tty;pty;
StartupNotify=true
StartupWMClass=com.mitchellh.ghostty
Terminal=false
Actions=new-window;
X-GNOME-UsesNotifications=true
X-TerminalArgExec=-e
X-TerminalArgTitle=--title=
X-TerminalArgAppId=--class=
X-TerminalArgDir=--working-directory=
X-TerminalArgHold=--wait-after-command

[Desktop Action new-window]
Name=New Window
Exec={{ $exec }}
